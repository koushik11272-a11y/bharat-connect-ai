          <div class="mt-4 pt-4 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-2 text-xs text-slate-400">
              <i data-lucide="languages" class="w-4 h-4 text-[#D4AF37]"></i>
              <span>Language: English Assistance Included</span>
            </div>
            <a href="#ai-trip-planner" class="px-5 py-2.5 rounded-xl bg-[#D4AF37] hover:bg-gold-600 text-navy-950 font-bold text-xs flex items-center gap-1.5 transition-all">
              <span>Generate Full Plan</span>
              <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
