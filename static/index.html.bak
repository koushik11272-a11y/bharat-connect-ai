  <!-- 9. LOCAL EXPERIENCES -->
  <!-- ================================================== -->
  <section id="experiences" class="py-24 bg-navy-900/60 border-y border-slate-800/80 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
        <div>
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block mb-2">Beyond Typical Sightseeing</span>
          <h2 class="font-serif-luxury text-3xl sm:text-4xl font-bold text-white leading-tight">
            Curated Local Experiences
          </h2>
          <p class="mt-2 text-sm text-slate-300 max-w-2xl leading-relaxed">
            Immerse yourself in centuries of living tradition: private cooking in royal havelis, sunrise boat aartis, master block printing, and pristine wildlife safaris.
          </p>
        </div>

        <!-- Multi-Dimensional Filters Bar -->
        <div class="flex flex-wrap items-center gap-3">
          <!-- City Selector -->
          <select id="exp-filter-city" onchange="renderExperiences()" class="px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-700 text-xs text-white focus:outline-none focus:border-gold-500">
            <option value="all">All Locations</option>
            <option value="Jaipur">Jaipur</option>
            <option value="New Delhi">New Delhi</option>
            <option value="Varanasi">Varanasi</option>
            <option value="Kochi">Kochi</option>
            <option value="Alleppey">Alleppey</option>
            <option value="Mumbai">Mumbai</option>
            <option value="Sawai Madhopur">Ranthambore (Tiger Safari)</option>
          </select>

          <!-- Duration Filter -->
          <select id="exp-filter-duration" onchange="renderExperiences()" class="px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-700 text-xs text-white focus:outline-none focus:border-gold-500">
            <option value="all">All Durations</option>
            <option value="short">Short (&lt; 3.5 Hours)</option>
            <option value="half">Half-Day (3.5 – 5 Hours)</option>
            <option value="full">Full-Day (6+ Hours)</option>
          </select>

          <!-- Budget Range Filter -->
          <select id="exp-filter-budget" onchange="renderExperiences()" class="px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-700 text-xs text-white focus:outline-none focus:border-gold-500">
            <option value="all">All Price Ranges</option>
            <option value="under50">Under $50 (&lt; ₹4,150)</option>
            <option value="50to100">$50 – $100</option>
            <option value="above100">$100+ (VIP Safaris & Houseboats)</option>
          </select>

          <!-- Experience Type Filter -->
          <select id="exp-filter-type" onchange="renderExperiences()" class="px-3.5 py-2 rounded-xl bg-slate-900 border border-slate-700 text-xs text-white focus:outline-none focus:border-gold-500">
            <option value="all">All Experience Types</option>
            <option value="Food">Culinary Masterclasses</option>
            <option value="Heritage">Heritage & Architecture Walks</option>
            <option value="Spiritual">Spiritual & Sunrise Ragas</option>
            <option value="Handicrafts">Artisan Craft Workshops</option>
            <option value="Wildlife">Wildlife & Nature Safaris</option>
            <option value="Markets">Local Spice Markets & Trade</option>
          </select>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 text-xs scrollbar-none">
        <button onclick="setExpCategory('all', this)" class="exp-category-tab px-4 py-2 rounded-xl bg-gold-500 text-navy-950 font-bold whitespace-nowrap transition-all">
          All Experiences
        </button>
        <button onclick="setExpCategory('Cooking', this)" class="exp-category-tab px-4 py-2 rounded-xl bg-slate-800/80 text-slate-300 hover:text-white whitespace-nowrap transition-all">
          Cooking & Food
        </button>
        <button onclick="setExpCategory('Heritage', this)" class="exp-category-tab px-4 py-2 rounded-xl bg-slate-800/80 text-slate-300 hover:text-white whitespace-nowrap transition-all">
          Heritage Walks
        </button>
        <button onclick="setExpCategory('Spiritual', this)" class="exp-category-tab px-4 py-2 rounded-xl bg-slate-800/80 text-slate-300 hover:text-white whitespace-nowrap transition-all">
          Spiritual & Dawn Ragas
        </button>
        <button onclick="setExpCategory('Handicrafts', this)" class="exp-category-tab px-4 py-2 rounded-xl bg-slate-800/80 text-slate-300 hover:text-white whitespace-nowrap transition-all">
          Artisan Workshops
        </button>
        <button onclick="setExpCategory('Wildlife', this)" class="exp-category-tab px-4 py-2 rounded-xl bg-slate-800/80 text-slate-300 hover:text-white whitespace-nowrap transition-all">
          Wildlife & Nature
        </button>
        <button onclick="setExpCategory('Markets', this)" class="exp-category-tab px-4 py-2 rounded-xl bg-slate-800/80 text-slate-300 hover:text-white whitespace-nowrap transition-all">
          Spice Docks & Bazaars
        </button>
