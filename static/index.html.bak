  <!-- 4. HERO SECTION -->
  <!-- ================================================== -->
  <section id="home" class="relative pt-32 pb-24 md:pt-40 md:pb-32 overflow-hidden bg-mandala">
    
    <!-- Cinematic Background Gradient & Visual Accents -->
    <div class="absolute inset-0 bg-gradient-to-b from-navy-950 via-navy-900/80 to-navy-950 z-0"></div>
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-gold-500/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
