  <!-- Guide Profile Modal -->
  <div id="guide-profile-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto space-y-6 relative border-gold-500/40">
      <button onclick="closeModal('guide-profile-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900"><i data-lucide="x" class="w-5 h-5"></i></button>
      
      <div class="flex flex-col sm:flex-row sm:items-center gap-5">
        <img id="guide-modal-avatar" src="" alt="" class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl object-cover border-2 border-gold-500/50 shadow-xl" />
        <div>
          <div class="flex items-center gap-2">
            <h3 id="guide-modal-name" class="text-2xl font-bold text-white"></h3>
            <span class="p-1 rounded-full bg-emerald-500/20 text-emerald-400" title="Verified"><i data-lucide="check" class="w-4 h-4"></i></span>
          </div>
          <p id="guide-modal-city" class="text-xs text-gold-400 mt-0.5 font-medium"></p>
          <span id="guide-modal-badge" class="inline-block px-2.5 py-0.5 rounded-full bg-gold-500/15 text-gold-300 text-[11px] font-semibold mt-2 border border-gold-500/30"></span>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3 text-center text-xs">
        <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
          <span class="text-slate-400 block text-[11px]">Rating</span>
          <span id="guide-modal-rating" class="font-bold text-white"></span>
        </div>
        <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
          <span class="text-slate-400 block text-[11px]">Experience</span>
          <span id="guide-modal-exp" class="font-bold text-white"></span>
        </div>
        <div class="p-3 rounded-xl bg-slate-900 border border-slate-800">
          <span class="text-slate-400 block text-[11px]">Daily Rate</span>
          <span id="guide-modal-price" class="font-bold text-gold-400"></span>
        </div>
      </div>

      <div>
        <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Biography & Background</h4>
        <p id="guide-modal-bio" class="text-xs text-slate-300 leading-relaxed"></p>
      </div>

      <div>
        <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Signature Curated Walks & Specialties</h4>
        <ul id="guide-modal-specialties" class="space-y-1.5"></ul>
      </div>

      <div class="pt-4 border-t border-slate-800 flex items-center justify-end gap-3">
        <button id="guide-modal-chat-btn" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold text-white flex items-center gap-1.5">
          <i data-lucide="message-square" class="w-4 h-4"></i>
          <span>Live Chat</span>
        </button>
        <button id="guide-modal-hire-btn" class="px-6 py-2.5 rounded-xl bg-gold-500 hover:bg-gold-600 text-navy-950 text-xs font-extrabold shadow-lg shadow-gold-500/20">
          Hire This Guide
        </button>
      </div>
    </div>
  </div>

  <!-- Guide Request / Hire Modal -->
  <div id="guide-request-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-lg w-full space-y-6 relative border-gold-500/40">
      <button onclick="closeModal('guide-request-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900"><i data-lucide="x" class="w-5 h-5"></i></button>

      <div>
        <h3 id="guide-req-name" class="text-xl font-bold text-white">Hire Verified Guide</h3>
        <p id="guide-req-city" class="text-xs text-gold-400 mt-1"></p>
      </div>

      <form onsubmit="handleGuideRequestSubmit(event)" class="space-y-4 text-xs">
        <input type="hidden" id="guide-req-guide-id" />
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Your Full Name</label>
          <input type="text" required placeholder="John Smith" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Email (for booking confirmation)</label>
          <input type="email" required placeholder="john@example.com" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Start Date</label>
            <input type="date" required value="2026-10-12" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Number of Days</label>
            <input type="number" min="1" max="14" value="2" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Special Requirements or Interests</label>
          <textarea rows="3" placeholder="Dietary restrictions, slow walking pace, photography focus..." class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500"></textarea>
        </div>
        <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 text-[11px] text-slate-400 flex items-center gap-2">
          <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400 shrink-0"></i>
          <span>Payments are held in escrow until your guide completes service satisfactorily.</span>
        </div>
        <div class="pt-3 flex justify-end gap-3">
          <button type="button" onclick="closeModal('guide-request-modal')" class="px-4 py-2 rounded-xl bg-slate-800 text-white font-semibold">Cancel</button>
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 text-navy-950 font-bold hover:bg-gold-600 shadow-md">Confirm Booking Request</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Live Simulated Guide Chat Modal -->
  <div id="guide-chat-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 max-w-lg w-full h-[550px] flex flex-col justify-between relative border-gold-500/40">
      
      <!-- Chat Header -->
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <div class="flex items-center gap-3">
          <img id="chat-guide-avatar" src="" alt="" class="w-10 h-10 rounded-full object-cover border border-gold-500" />
          <div>
            <h4 id="chat-guide-name" class="font-bold text-white text-sm"></h4>
            <p id="chat-guide-status" class="text-[11px] text-emerald-400 flex items-center gap-1"></p>
          </div>
        </div>
        <button onclick="closeModal('guide-chat-modal')" class="text-slate-400 hover:text-white p-1.5 rounded-lg bg-slate-900"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <!-- Messages Area -->
      <div id="chat-messages-container" class="flex-1 overflow-y-auto py-4 space-y-3 pr-1"></div>

      <!-- Input Area -->
      <form onsubmit="sendChatMessage(event)" class="pt-3 border-t border-slate-800 flex items-center gap-2">
        <input type="hidden" id="chat-guide-id" />
        <input type="text" id="chat-input" placeholder="Ask about routes, timing, havelis..." class="flex-1 px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-xs text-white focus:outline-none focus:border-gold-500" />
        <button type="submit" class="p-2.5 rounded-xl bg-gold-500 text-navy-950 hover:bg-gold-600 transition-colors">
          <i data-lucide="send" class="w-4 h-4"></i>
        </button>
      </form>

    </div>
  </div>

  <!-- Book Experience Modal -->
  <div id="book-experience-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-lg w-full space-y-6 relative border-gold-500/40">
      <button onclick="closeModal('book-experience-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900"><i data-lucide="x" class="w-5 h-5"></i></button>

      <div>
        <h3 id="book-exp-title" class="text-xl font-bold text-white">Reserve Experience</h3>
        <p id="book-exp-city" class="text-xs text-gold-400 mt-1"></p>
        <p id="book-exp-price" class="text-sm font-bold text-white mt-1"></p>
      </div>

      <form onsubmit="handleBookExperienceSubmit(event)" class="space-y-4 text-xs">
        <input type="hidden" id="book-exp-id" />
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Primary Guest Name</label>
          <input type="text" required placeholder="Sarah Jenkins" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Date</label>
            <input type="date" required value="2026-10-14" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Number of Guests</label>
            <input type="number" min="1" max="10" value="2" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Dietary Preferences or Notes</label>
          <textarea rows="2" placeholder="Vegetarian, nut allergy, wheelchair accessible..." class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500"></textarea>
        </div>
        <div class="pt-3 flex justify-end gap-3">
          <button type="button" onclick="closeModal('book-experience-modal')" class="px-4 py-2 rounded-xl bg-slate-800 text-white font-semibold">Cancel</button>
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 text-navy-950 font-bold hover:bg-gold-600 shadow-md">Complete Reservation</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Global Collaboration Modal -->
  <div id="collaboration-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-lg w-full space-y-6 relative border-gold-500/40">
      <button onclick="closeModal('collaboration-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900"><i data-lucide="x" class="w-5 h-5"></i></button>

      <div>
        <span class="text-[11px] font-bold text-gold-400 uppercase tracking-wider">Cross-Border Partnership Request</span>
        <h3 id="collab-partner-name" class="text-xl font-bold text-white mt-1"></h3>
        <p id="collab-partner-industry" class="text-xs text-slate-400"></p>
      </div>

      <form onsubmit="handleCollaborationSubmit(event)" class="space-y-4 text-xs">
        <input type="hidden" id="collab-partner-id" />
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Your Name</label>
            <input type="text" id="collab-name" required placeholder="Michael Chang" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Business Email</label>
            <input type="email" id="collab-email" required placeholder="michael@craftsauce.com" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Company / Organization</label>
            <input type="text" id="collab-company" required placeholder="Austin Artisan Foods LLC" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Your Country</label>
            <input type="text" id="collab-country" value="United States" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Proposed Collaboration Overview</label>
          <textarea id="collab-message" rows="3" required placeholder="We are seeking direct organic Tellicherry pepper sample shipments and co-branding for our North American line..." class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500"></textarea>
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Proposed Virtual or In-Person Meeting Date</label>
          <input type="date" id="collab-date" value="2026-10-18" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
        </div>
        <div class="p-3 rounded-xl bg-navy-950 border border-slate-800 text-[10px] text-slate-400">
          *BharatConnect AI facilitates introductions only; users independently conduct legal and customs due diligence.
        </div>
        <div class="pt-2 flex justify-end gap-3">
          <button type="button" onclick="closeModal('collaboration-modal')" class="px-4 py-2 rounded-xl bg-slate-800 text-white font-semibold">Cancel</button>
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 text-navy-950 font-bold hover:bg-gold-600 shadow-md">Send Partnership Request</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Partner Application Modal (Become a Partner) -->
  <div id="partner-apply-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-lg w-full space-y-6 relative border-gold-500/40 max-h-[90vh] overflow-y-auto">
      <button onclick="closeModal('partner-apply-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900"><i data-lucide="x" class="w-5 h-5"></i></button>

      <div>
        <h3 class="text-xl font-bold text-white">Join the Verified Partner Network</h3>
        <p class="text-xs text-slate-400 mt-1">For Indian producers, havelis, spice estates, and tourism enterprises seeking international collaboration.</p>
      </div>

      <form onsubmit="handlePartnerApplicationSubmit(event)" class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Registered Enterprise Name</label>
          <input type="text" id="partner-apply-biz" required placeholder="E.g. Royal Jaipur Block Printing Guild" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Contact Person</label>
            <input type="text" id="partner-apply-person" required placeholder="Rajesh Rathore" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Official Email</label>
            <input type="email" id="partner-apply-email" required placeholder="director@jaipurguild.org" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Phone / WhatsApp</label>
            <input type="tel" id="partner-apply-phone" required placeholder="+91 98290 XXXXX" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
          <div>
            <label class="block text-slate-400 font-semibold mb-1">City & State</label>
            <input type="text" id="partner-apply-city" required placeholder="Jaipur, Rajasthan" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Primary Industry Category</label>
          <select id="partner-apply-industry" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
            <option>Handicrafts and Textiles</option>
            <option>Spices and Food Products</option>
            <option>Hospitality & Heritage Havelis</option>
            <option>Technology & Tourism Software</option>
            <option>Sustainable & Herbal Wellness</option>
          </select>
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Brief Description of Offerings & Export Readiness</label>
          <textarea id="partner-apply-desc" rows="3" required placeholder="Describe certifications (GST, Spices Board, Fair Trade, etc.) and what you offer to global partners..." class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500"></textarea>
        </div>
        <div class="pt-2 flex justify-end gap-3">
          <button type="button" onclick="closeModal('partner-apply-modal')" class="px-4 py-2 rounded-xl bg-slate-800 text-white font-semibold">Cancel</button>
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 text-navy-950 font-bold hover:bg-gold-600 shadow-md">Submit for Verification Audit</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Create Community Post Modal -->
  <div id="create-post-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-lg w-full space-y-6 relative border-gold-500/40">
      <button onclick="closeModal('create-post-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900"><i data-lucide="x" class="w-5 h-5"></i></button>

      <div>
        <h3 class="text-xl font-bold text-white">Share Your Story or Tip</h3>
        <p class="text-xs text-slate-400 mt-1">Help global travelers discover the authentic pulse of India.</p>
      </div>

      <form onsubmit="handleCreatePostSubmit(event)" class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Post Title</label>
          <input type="text" id="new-post-title" required placeholder="E.g. Hidden Rooftop Sunset Over Varanasi Ghats" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Category</label>
            <select id="new-post-category" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
              <option value="Traveler Stories">Traveler Stories</option>
              <option value="Business & Collaboration">Business & Collaboration</option>
              <option value="Family Travel">Family Travel</option>
              <option value="Spiritual & Wellness">Spiritual & Wellness</option>
              <option value="Local Tips">Local Tips</option>
            </select>
          </div>
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Your Hometown / State</label>
            <input type="text" id="new-post-origin" value="Seattle, WA, USA" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Tags (comma separated)</label>
          <input type="text" id="new-post-tags" placeholder="Varanasi, Sunrise, Ghats, Meditation" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Your Experience / Story</label>
          <textarea id="new-post-content" rows="4" required placeholder="Describe what made this experience special, guide recommendations, or practical tips..." class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500"></textarea>
        </div>
        <div class="pt-2 flex justify-end gap-3">
          <button type="button" onclick="closeModal('create-post-modal')" class="px-4 py-2 rounded-xl bg-slate-800 text-white font-semibold">Cancel</button>
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 text-navy-950 font-bold hover:bg-gold-600 shadow-md">Publish Story</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Global Quick Search Modal (Cmd/Ctrl + K) -->
  <div id="global-search-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-start justify-center pt-24 p-4 hidden">
    <div class="glass-panel rounded-3xl p-5 max-w-xl w-full space-y-4 relative border-gold-500/40">
      <div class="relative">
        <i data-lucide="search" class="w-5 h-5 text-gold-400 absolute left-3.5 top-3.5"></i>
        <input type="text" id="global-search-input" placeholder="Search guides, havelis, experiences, spices, cities..." class="w-full pl-11 pr-10 py-3 rounded-2xl bg-slate-900 border border-slate-700 text-white text-sm focus:outline-none focus:border-gold-500" />
        <button onclick="toggleSearchModal()" class="absolute right-3.5 top-3 text-slate-400 hover:text-white text-xs">ESC</button>
      </div>
      <div id="global-search-results" class="max-h-72 overflow-y-auto space-y-1 pr-1">
        <p class="text-xs text-slate-500 py-4 text-center">Type a destination, guide name, spice, or craft to search...</p>
      </div>
    </div>
  </div>

  <!-- Emergency SOS & Embassy Drawer -->
  <div id="emergency-sos-drawer" class="fixed bottom-6 right-6 z-50 max-w-md w-full glass-panel rounded-3xl p-6 border-red-500/40 shadow-2xl space-y-4 hidden bg-navy-950/95">
    <div class="flex items-center justify-between pb-3 border-b border-slate-800">
      <div class="flex items-center gap-2 text-red-400 font-bold text-sm">
        <i data-lucide="shield-alert" class="w-5 h-5"></i>
        <span>Tourist Safety & Emergency Hub</span>
      </div>
      <button onclick="toggleEmergencyDrawer()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
    </div>

    <div class="space-y-2.5 text-xs">
      <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800 flex items-center justify-between">
        <div>
          <span class="font-bold text-white block">US Embassy New Delhi</span>
          <span class="text-slate-400 text-[11px]">Consular Emergency Services</span>
        </div>
        <a href="tel:+911124198000" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-gold-500 hover:text-navy-950 text-[#D4AF37] font-bold text-xs transition-colors flex items-center gap-1">
          <i data-lucide="phone" class="w-3 h-3"></i> Call
        </a>
      </div>

      <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800 flex items-center justify-between">
        <div>
          <span class="font-bold text-white block">National Tourist Helpline (India)</span>
          <span class="text-slate-400 text-[11px]">24/7 Toll-free in 12 Languages</span>
        </div>
        <a href="tel:1363" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-gold-500 hover:text-navy-950 text-[#D4AF37] font-bold text-xs transition-colors flex items-center gap-1">
          <i data-lucide="phone" class="w-3 h-3"></i> 1363
        </a>
      </div>

      <div class="p-3 rounded-xl bg-slate-900/80 border border-slate-800 flex items-center justify-between">
        <div>
          <span class="font-bold text-white block">All-India Emergency Number</span>
          <span class="text-slate-400 text-[11px]">Police, Ambulance, Fire</span>
        </div>
        <a href="tel:112" class="px-3 py-1.5 rounded-lg bg-red-500/20 text-red-400 font-bold text-xs flex items-center gap-1">
          <i data-lucide="phone" class="w-3 h-3"></i> 112
        </a>
      </div>
    </div>

    <div class="pt-2 text-[10px] text-slate-500 text-center">
      BharatConnect concierge is also accessible 24/7 via in-app chat for all Premium Pass members.
    </div>
  </div>

  <!-- Packing Checklist Modal -->
  <div id="packing-checklist-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-lg w-full space-y-6 relative border-gold-500/40 max-h-[85vh] overflow-y-auto">
      <button onclick="closeModal('packing-checklist-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900"><i data-lucide="x" class="w-5 h-5"></i></button>

      <div>
        <h3 class="text-xl font-bold text-white">Pre-Travel India Packing Checklist</h3>
        <p class="text-xs text-gold-400 mt-1">Curated specifically for international travelers.</p>
      </div>

      <div class="space-y-3 text-xs">
        <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800">
          <h5 class="font-bold text-amber-300 mb-1.5 flex items-center gap-1.5"><i data-lucide="file-text" class="w-3.5 h-3.5"></i> Documents & Digital</h5>
          <ul class="space-y-1 text-slate-300">
            <li>• Indian e-Tourist Visa printout & original US passport (6 months validity)</li>
            <li>• Digital copy of yellow fever/vaccination certificates (if applicable)</li>
            <li>• Unlocked smartphone ready for Airtel / Jio eSIM activation</li>
          </ul>
        </div>

        <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800">
          <h5 class="font-bold text-amber-300 mb-1.5 flex items-center gap-1.5"><i data-lucide="shirt" class="w-3.5 h-3.5"></i> Clothing & Sacred Etiquette</h5>
          <ul class="space-y-1 text-slate-300">
            <li>• Breathable linen & cotton garments covering knees and shoulders</li>
            <li>• Slip-on shoes and comfortable cotton socks for temple marble visits</li>
            <li>• Lightweight pashmina or scarf for sudden breezes and temple covering</li>
          </ul>
        </div>

        <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800">
          <h5 class="font-bold text-amber-300 mb-1.5 flex items-center gap-1.5"><i data-lucide="heart-pulse" class="w-3.5 h-3.5"></i> Health & Wellness</h5>
          <ul class="space-y-1 text-slate-300">
            <li>• Electrolyte hydration packets and personal probiotic supplements</li>
            <li>• Mosquito repellent with DEET/Picaridin and high-SPF sunscreen</li>
            <li>• Hand sanitizer and pocket tissue packs</li>
          </ul>
        </div>
      </div>

      <div class="pt-2 flex justify-end">
        <button onclick="closeModal('packing-checklist-modal')" class="px-5 py-2 rounded-xl bg-gold-500 text-navy-950 font-bold text-xs">Got it, Ready!</button>
      </div>
    </div>
  </div>

  <!-- Ambassador Modal -->
  <div id="ambassador-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-lg w-full space-y-6 relative border-gold-500/40">
      <button onclick="closeModal('ambassador-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900"><i data-lucide="x" class="w-5 h-5"></i></button>

      <div>
        <h3 class="text-xl font-bold text-white">India Travel Ambassador Program</h3>
        <p class="text-xs text-gold-400 mt-1">Become a certified global voice for sustainable, authentic Indian tourism.</p>
      </div>

      <div class="space-y-3 text-xs text-slate-300 leading-relaxed">
        <p>After completing your journey, join our circle of international ambassadors across North America and Europe. Host local cultural meetups, guide first-time travelers, and receive complimentary Premium Pass privileges.</p>
        <div class="p-3 rounded-xl bg-slate-900/70 border border-slate-800 space-y-1">
          <div class="font-bold text-white">Ambassador Perks:</div>
          <div>• VIP complimentary access to all BharatConnect partner events</div>
          <div>• Direct invites to artisan preview launches in New York & San Francisco</div>
          <div>• Exclusive ambassador badge on traveler profiles</div>
        </div>
      </div>

      <div class="pt-2 flex justify-end gap-3">
        <button type="button" onclick="closeModal('ambassador-modal')" class="px-4 py-2 rounded-xl bg-slate-800 text-white font-semibold text-xs">Close</button>
        <button onclick="closeModal('ambassador-modal'); showToast('Application Received', 'Welcome to the India Travel Ambassador candidate circle. Our community lead will contact you.', 'success');" class="px-5 py-2 rounded-xl bg-gold-500 text-navy-950 font-bold text-xs">Apply Now</button>
      </div>
    </div>
  </div>

  <!-- Sign In Modal -->
  <div id="signin-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-md w-full space-y-5 relative border-gold-500/40 shadow-2xl">
      <button onclick="closeModal('signin-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900/80 border border-slate-700 transition-colors"><i data-lucide="x" class="w-5 h-5"></i></button>

      <div class="text-center pt-2">
        <div class="w-12 h-12 rounded-2xl bg-gold-500/20 text-gold-400 flex items-center justify-center mx-auto mb-3 border border-gold-500/30 shadow-lg shadow-gold-500/10">
          <i data-lucide="lock" class="w-6 h-6"></i>
        </div>
        <div class="inline-block px-3 py-0.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-[10px] font-bold uppercase tracking-wider mb-1.5">
          Member Access
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white font-serif-luxury">Welcome to BharatConnect AI</h3>
        <p class="text-xs text-slate-400 mt-1">Sign in to unlock personalized itineraries, verified guides, and global collaborations.</p>
      </div>

      <!-- Sign In Error Alert Box -->
      <div id="signin-error-alert" class="hidden p-3.5 rounded-xl bg-red-500/15 border border-red-500/40 text-red-300 text-xs flex items-start gap-2.5 transition-all">
        <i data-lucide="alert-circle" class="w-4 h-4 text-red-400 shrink-0 mt-0.5"></i>
        <div id="signin-error-message" class="flex-1 font-medium">Invalid email or password. Please try again.</div>
      </div>

      <form id="signin-form" onsubmit="handleSigninSubmit(event)" novalidate class="space-y-4 text-xs">
        <div>
          <label for="signin-email" class="block text-slate-300 font-semibold mb-1 flex items-center gap-1.5">
            <i data-lucide="mail" class="w-3.5 h-3.5 text-gold-400"></i> Email Address <span class="text-gold-400">*</span>
          </label>
          <input type="email" id="signin-email" required placeholder="traveler@example.com" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-gold-500 transition-colors" />
        </div>
        <div>
          <label for="signin-password" class="block text-slate-300 font-semibold mb-1 flex items-center gap-1.5">
            <i data-lucide="lock" class="w-3.5 h-3.5 text-gold-400"></i> Password <span class="text-gold-400">*</span>
          </label>
          <div class="relative">
            <input type="password" id="signin-password" required placeholder="Enter your password" class="w-full pl-3.5 pr-10 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-gold-500 transition-colors" />
            <button type="button" onclick="togglePasswordVisibility('signin-password', this)" class="absolute right-3 top-2.5 text-slate-400 hover:text-white transition-colors" title="Toggle password visibility">
              <i data-lucide="eye" class="w-4 h-4"></i>
            </button>
          </div>
        </div>
        <button type="submit" id="signin-submit-btn" class="w-full py-3 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 hover:brightness-110 text-navy-950 font-bold text-xs tracking-wide transition-all shadow-lg shadow-gold-500/20 active:scale-[0.99] flex items-center justify-center gap-2">
          <i data-lucide="log-in" class="w-4 h-4"></i>
          <span id="signin-btn-text">Sign In</span>
        </button>
        <div class="text-center text-[11px] text-slate-400 pt-1">
          Don't have an account? <button type="button" onclick="closeModal('signin-modal'); openModal('signup-modal');" class="text-gold-400 hover:text-gold-300 hover:underline font-semibold ml-1">Create Account</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Local Assistance Modal -->
  <div id="local-assistance-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-lg w-full space-y-6 relative border-gold-500/40">
      <button onclick="closeModal('local-assistance-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900"><i data-lucide="x" class="w-5 h-5"></i></button>

      <div>
        <h3 class="text-xl font-bold text-white">Request Local Ground Assistance</h3>
        <p class="text-xs text-gold-400 mt-1">Connect your active itinerary with our on-ground concierge.</p>
      </div>

      <form onsubmit="event.preventDefault(); closeModal('local-assistance-modal'); showToast('Assistance Requested', 'A BharatConnect concierge will review your itinerary and reach out via WhatsApp/email within 2 hours.', 'success');" class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Your Name</label>
          <input type="text" required placeholder="David Miller" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 font-semibold mb-1">WhatsApp / Phone</label>
            <input type="tel" required placeholder="+1 312 XXX XXXX" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Preferred Time to Contact</label>
            <select class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
              <option>Morning (EST)</option>
              <option>Afternoon (EST)</option>
              <option>Evening (EST)</option>
              <option>Instant WhatsApp</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Specific Assistance Needed</label>
          <textarea rows="3" placeholder="Private chauffeur confirmation, domestic flight bookings, haveli dietary arrangement..." class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500"></textarea>
        </div>
        <div class="pt-2 flex justify-end gap-3">
          <button type="button" onclick="closeModal('local-assistance-modal')" class="px-4 py-2 rounded-xl bg-slate-800 text-white font-semibold">Cancel</button>
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 text-navy-950 font-bold hover:bg-gold-600 shadow-md">Dispatch Concierge Request</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Sign Up / User Registration Modal -->
  <div id="signup-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-lg w-full max-h-[92vh] overflow-y-auto space-y-5 relative border-gold-500/40 shadow-2xl">
      <button onclick="closeModal('signup-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900/80 border border-slate-700 transition-colors"><i data-lucide="x" class="w-5 h-5"></i></button>

      <!-- Modal Header -->
      <div class="text-center pt-2">
        <div class="w-12 h-12 rounded-2xl bg-gold-500/20 text-gold-400 flex items-center justify-center mx-auto mb-3 border border-gold-500/30 shadow-lg shadow-gold-500/10">
          <i data-lucide="user-plus" class="w-6 h-6"></i>
        </div>
        <div class="inline-block px-3 py-0.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-[10px] font-bold uppercase tracking-wider mb-1.5">
          Join BharatConnect AI
        </div>
        <h3 class="text-xl sm:text-2xl font-bold text-white font-serif-luxury">Create Your Account</h3>
        <p class="text-xs text-slate-400 mt-1 max-w-xs mx-auto">Start planning authentic Indian journeys and connect with verified local guides and artisans.</p>
      </div>

      <!-- Error Alert Box -->
      <div id="signup-error-alert" class="hidden p-3.5 rounded-xl bg-red-500/15 border border-red-500/40 text-red-300 text-xs flex items-start gap-2.5 transition-all">
        <i data-lucide="alert-circle" class="w-4 h-4 text-red-400 shrink-0 mt-0.5"></i>
        <div id="signup-error-message" class="flex-1 font-medium"></div>
      </div>

      <!-- Success View Box -->
      <div id="signup-success-view" class="hidden p-6 rounded-2xl bg-emerald-500/15 border border-emerald-500/40 text-emerald-200 text-center space-y-3 transition-all">
        <div class="w-12 h-12 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto border border-emerald-500/40">
          <i data-lucide="check" class="w-6 h-6"></i>
        </div>
        <h4 class="text-base font-bold text-white font-serif-luxury">Account Created Successfully!</h4>
        <p id="signup-success-message" class="text-xs text-emerald-300/90 leading-relaxed"></p>
        <div class="pt-2">
          <button type="button" onclick="closeModal('signup-modal'); openModal('signin-modal');" class="px-6 py-2.5 rounded-xl bg-gold-500 hover:bg-gold-400 text-navy-950 font-bold text-xs shadow-md transition-all">
            Proceed to Sign In
          </button>
        </div>
      </div>

      <!-- Registration Form -->
      <form id="signup-form" onsubmit="handleSignupSubmit(event)" novalidate class="space-y-4 text-xs">
        <!-- Full Name -->
        <div>
          <label for="signup-name" class="block text-slate-300 font-semibold mb-1 flex items-center gap-1.5">
            <i data-lucide="user" class="w-3.5 h-3.5 text-gold-400"></i> Full Name <span class="text-gold-400">*</span>
          </label>
          <input type="text" id="signup-name" required placeholder="e.g. David Miller" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-gold-500 transition-colors" />
          <span id="signup-name-error" class="text-[11px] text-red-400 hidden mt-1"></span>
        </div>

        <!-- Email Address -->
        <div>
          <label for="signup-email" class="block text-slate-300 font-semibold mb-1 flex items-center gap-1.5">
            <i data-lucide="mail" class="w-3.5 h-3.5 text-gold-400"></i> Email Address <span class="text-gold-400">*</span>
          </label>
          <input type="email" id="signup-email" required placeholder="david.miller@example.com" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-gold-500 transition-colors" />
          <span id="signup-email-error" class="text-[11px] text-red-400 hidden mt-1"></span>
        </div>

        <!-- Phone / WhatsApp Number & Country in 2 cols -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="signup-phone" class="block text-slate-300 font-semibold mb-1 flex items-center gap-1.5">
              <i data-lucide="phone" class="w-3.5 h-3.5 text-gold-400"></i> Mobile / WhatsApp <span class="text-gold-400">*</span>
            </label>
            <input type="tel" id="signup-phone" required placeholder="+1 555-019-2834" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-gold-500 transition-colors" />
            <span id="signup-phone-error" class="text-[11px] text-red-400 hidden mt-1"></span>
          </div>

          <div>
            <label for="signup-country" class="block text-slate-300 font-semibold mb-1 flex items-center gap-1.5">
              <i data-lucide="globe" class="w-3.5 h-3.5 text-gold-400"></i> Country <span class="text-gold-400">*</span>
            </label>
            <select id="signup-country" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white focus:outline-none focus:border-gold-500 transition-colors">
              <option value="United States">United States</option>
              <option value="India">India</option>
              <option value="United Kingdom">United Kingdom</option>
              <option value="Canada">Canada</option>
              <option value="Australia">Australia</option>
              <option value="Germany">Germany</option>
              <option value="France">France</option>
              <option value="Japan">Japan</option>
              <option value="Italy">Italy</option>
              <option value="Spain">Spain</option>
              <option value="Singapore">Singapore</option>
              <option value="United Arab Emirates">United Arab Emirates</option>
              <option value="Brazil">Brazil</option>
              <option value="South Africa">South Africa</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>

        <!-- Password -->
        <div>
          <label for="signup-password" class="block text-slate-300 font-semibold mb-1 flex items-center gap-1.5">
            <i data-lucide="lock" class="w-3.5 h-3.5 text-gold-400"></i> Password <span class="text-gold-400">*</span>
          </label>
          <div class="relative">
            <input type="password" id="signup-password" required placeholder="Minimum 8 characters (letters & numbers)" oninput="evaluatePasswordStrength(this.value)" class="w-full pl-3.5 pr-10 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-gold-500 transition-colors" />
            <button type="button" onclick="togglePasswordVisibility('signup-password', this)" class="absolute right-3 top-2.5 text-slate-400 hover:text-white transition-colors" title="Toggle password visibility">
              <i data-lucide="eye" class="w-4 h-4"></i>
            </button>
          </div>
          <!-- Dynamic Password Strength Meter -->
          <div class="mt-2 space-y-1">
            <div class="h-1.5 w-full bg-slate-800 rounded-full overflow-hidden flex gap-1">
              <div id="pwd-meter-1" class="h-full w-1/4 rounded-full bg-slate-700 transition-all duration-300"></div>
              <div id="pwd-meter-2" class="h-full w-1/4 rounded-full bg-slate-700 transition-all duration-300"></div>
              <div id="pwd-meter-3" class="h-full w-1/4 rounded-full bg-slate-700 transition-all duration-300"></div>
              <div id="pwd-meter-4" class="h-full w-1/4 rounded-full bg-slate-700 transition-all duration-300"></div>
            </div>
            <div class="flex justify-between items-center text-[10px] text-slate-400">
              <span>Strength: <strong id="pwd-strength-text" class="text-slate-500 font-medium">Enter password</strong></span>
              <span class="text-slate-500">Min 8 chars, 1 letter & 1 number</span>
            </div>
          </div>
          <span id="signup-password-error" class="text-[11px] text-red-400 hidden mt-1"></span>
        </div>

        <!-- Confirm Password -->
        <div>
          <label for="signup-confirm-password" class="block text-slate-300 font-semibold mb-1 flex items-center gap-1.5">
            <i data-lucide="check-check" class="w-3.5 h-3.5 text-gold-400"></i> Confirm Password <span class="text-gold-400">*</span>
          </label>
          <div class="relative">
            <input type="password" id="signup-confirm-password" required placeholder="Re-enter your password" oninput="checkPasswordMatch()" class="w-full pl-3.5 pr-10 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-gold-500 transition-colors" />
            <button type="button" onclick="togglePasswordVisibility('signup-confirm-password', this)" class="absolute right-3 top-2.5 text-slate-400 hover:text-white transition-colors" title="Toggle password visibility">
              <i data-lucide="eye" class="w-4 h-4"></i>
            </button>
          </div>
          <span id="signup-confirm-error" class="text-[11px] text-red-400 hidden mt-1"></span>
          <span id="signup-confirm-match" class="text-[11px] text-emerald-400 hidden mt-1 flex items-center gap-1">
            <i data-lucide="check" class="w-3.5 h-3.5"></i> Passwords match
          </span>
        </div>

        <!-- Profile Type (Hidden default for backward compatibility) -->
        <input type="hidden" id="signup-role" value="International Traveler" />

        <!-- Terms & Privacy Checkbox -->
        <div class="pt-1">
          <label class="flex items-start gap-2.5 cursor-pointer select-none">
            <input type="checkbox" id="signup-terms" required class="mt-0.5 rounded border-slate-700 bg-slate-900 text-gold-500 focus:ring-gold-500 focus:ring-offset-navy-950 w-4 h-4" />
            <span class="text-[11px] text-slate-300 leading-tight">
              I agree to BharatConnect AI's <a href="#about-us" onclick="closeModal('signup-modal')" class="text-gold-400 hover:underline">Terms of Service</a> & <a href="#about-us" onclick="closeModal('signup-modal')" class="text-gold-400 hover:underline">Privacy Policy</a>.
            </span>
          </label>
          <span id="signup-terms-error" class="text-[11px] text-red-400 hidden mt-1"></span>
        </div>

        <!-- Submit Button -->
        <button type="submit" id="signup-submit-btn" class="w-full py-3 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 hover:brightness-110 text-navy-950 font-bold text-xs tracking-wide transition-all shadow-lg shadow-gold-500/20 active:scale-[0.99] flex items-center justify-center gap-2">
          <i data-lucide="shield-check" class="w-4 h-4"></i>
          <span id="signup-btn-text">Register</span>
        </button>

        <!-- Switch to Sign In -->
        <div class="text-center text-[11px] text-slate-400 pt-1">
          Already have an account? <button type="button" onclick="closeModal('signup-modal'); openModal('signin-modal');" class="text-gold-400 hover:text-gold-300 hover:underline font-semibold ml-1">Sign In</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Incident / Support Report Modal -->
  <div id="report-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-lg w-full space-y-6 relative border-gold-500/40">
      <button onclick="closeModal('report-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900"><i data-lucide="x" class="w-5 h-5"></i></button>

      <div>
        <div class="flex items-center gap-2 text-gold-400 mb-1">
          <i data-lucide="shield-check" class="w-5 h-5"></i>
          <span class="text-xs uppercase tracking-widest font-bold">24/7 Safety & Ombudsman</span>
        </div>
        <h3 class="text-xl font-bold text-white">Submit Incident Report or Inquiry</h3>
        <p class="text-xs text-slate-400 mt-1">Guaranteed 2-hour response dispatch by our dedicated bilingual travel safety team.</p>
      </div>

      <form id="report-form" onsubmit="handleReportSubmit(event)" class="space-y-4 text-xs">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Your Name</label>
            <input type="text" id="report-name" required placeholder="David Miller" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Email Address</label>
            <input type="email" id="report-email" required placeholder="david@example.com" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Report Category</label>
          <select id="report-category" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
            <option value="Guide Conduct / Service Issue">Guide Conduct / Service Issue</option>
            <option value="Billing / Overcharging Dispute">Billing / Overcharging Dispute</option>
            <option value="Medical / Personal Safety Concern">Medical / Personal Safety Concern</option>
            <option value="Emergency Ground Assistance">Emergency Ground Assistance</option>
            <option value="General Inquiry / Feedback">General Inquiry / Feedback</option>
          </select>
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Description of Incident / Request</label>
          <textarea id="report-description" rows="3" required placeholder="Please describe what occurred, location, date, and any specific assistance required..." class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500"></textarea>
        </div>
        <div class="p-3 rounded-xl bg-navy-900/80 border border-slate-800 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <input type="checkbox" id="report-urgent" class="rounded accent-gold-500" />
            <label for="report-urgent" class="text-white font-medium">Urgent: Request immediate phone / WhatsApp callback</label>
          </div>
          <span class="text-[10px] text-amber-400 font-bold px-2 py-0.5 rounded-md bg-amber-500/10">Priority Dispatch</span>
        </div>
        <div class="pt-2 flex justify-end gap-3">
          <button type="button" onclick="closeModal('report-modal')" class="px-4 py-2 rounded-xl bg-slate-800 text-white font-semibold">Cancel</button>
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 text-navy-950 font-bold hover:bg-gold-600 shadow-md">Submit Safety Report</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Join Community Modal -->
  <div id="join-community-modal" class="modal-backdrop fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="glass-panel rounded-3xl p-6 sm:p-8 max-w-md w-full space-y-6 relative border-gold-500/40">
      <button onclick="closeModal('join-community-modal')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-full bg-slate-900"><i data-lucide="x" class="w-5 h-5"></i></button>

      <div class="text-center">
        <div class="w-12 h-12 rounded-2xl bg-gold-500/20 text-gold-400 flex items-center justify-center mx-auto mb-3">
          <i data-lucide="users" class="w-6 h-6"></i>
        </div>
        <h3 class="text-xl font-bold text-white">Join BharatConnect Traveler Circle</h3>
        <p class="text-xs text-slate-400 mt-1">Connect with seasoned international travelers and local hosts for insider travel advice.</p>
      </div>

      <form id="join-community-form" onsubmit="handleJoinCommunitySubmit(event)" class="space-y-4 text-xs">
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Your Name</label>
          <input type="text" id="community-name" required placeholder="e.g. David Miller" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Email Address</label>
          <input type="email" id="community-email" required placeholder="david@example.com" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Select Traveler Circle</label>
          <select id="community-circle" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
            <option value="First-Time India Travelers (US/Global)">First-Time India Travelers (US/Global)</option>
            <option value="Heritage & Photography Enthusiasts">Heritage & Photography Enthusiasts</option>
            <option value="Culinary & Spice Trail Explorers">Culinary & Spice Trail Explorers</option>
            <option value="Cross-Border Business & Innovation Lounge">Cross-Border Business & Innovation Lounge</option>
          </select>
        </div>
        <div>
          <label class="block text-slate-400 font-semibold mb-1">Home City / Country</label>
          <input type="text" id="community-home" required placeholder="e.g. Chicago, IL, United States" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
        </div>
        <button type="submit" class="w-full py-3 rounded-xl bg-gold-500 hover:bg-gold-600 text-navy-950 font-bold text-xs transition-colors shadow-md">
          Join Circle Free
        </button>
      </form>
    </div>
  </div>

  <!-- Scripts -->
  <script src="/static/js/app.js"></script>
  <script>
    // Helper function for membership checkout modal
    function openJoinPassModal(tier, price) {
      showToast(`${tier} Tier Selected`, `Proceeding with ${tier} Pass membership at ${formatCurrency(price)}/mo. Welcome to BharatConnect!`, 'success');
    }
  </script>
</body>
</html>
