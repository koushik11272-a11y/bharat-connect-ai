        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href="#ai-trip-planner" class="px-7 py-3.5 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 text-navy-950 font-bold text-sm shadow-xl shadow-gold-500/25 hover:shadow-gold-500/40 hover:scale-105 active:scale-95 transition-all duration-200 flex items-center gap-2">
            <i data-lucide="sparkles" class="w-4 h-4 text-navy-950"></i>
            <span>Plan My Trip</span>
          </a>
          <a href="#explore-india" class="px-7 py-3.5 rounded-xl bg-navy-900/80 border border-gold-500/30 hover:border-gold-500 text-white font-semibold text-sm hover:bg-navy-800 transition-all duration-200 flex items-center gap-2">
            <span>Explore India</span>
            <i data-lucide="arrow-right" class="w-4 h-4 text-gold-400"></i>
          </a>
        </div>
      </div>

      <!-- Quick Search / AI Quick Planning Card + Itinerary Live Preview Card -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <!-- Left: Quick Search Card -->
        <div class="lg:col-span-7 glass-panel rounded-3xl p-6 sm:p-8 gold-glow relative">
          <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-6">
            <div class="flex items-center gap-2.5">
              <div class="w-3 h-3 rounded-full bg-gold-400"></div>
              <h3 class="font-bold text-white text-base">Instant AI Travel Concierge</h3>
            </div>
            <span class="text-[11px] font-semibold text-gold-400 bg-gold-500/10 px-2.5 py-1 rounded-full border border-gold-500/20">
              Personalized for US Travelers
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div>
              <label class="block text-slate-400 font-semibold mb-1">Destination in India</label>
              <div class="relative">
                <i data-lucide="map-pin" class="w-4 h-4 text-gold-400 absolute left-3 top-3"></i>
                <select id="hero-quick-dest" class="w-full pl-9 pr-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
                  <option value="Golden Triangle (Delhi, Agra, Jaipur)">Golden Triangle (Delhi, Agra, Jaipur)</option>
                  <option value="Kerala Backwaters & Spice Coast">Kerala Backwaters & Spice Coast</option>
                  <option value="Varanasi & Sacred North">Varanasi & Sacred North</option>
                  <option value="Royal Rajasthan Palaces">Royal Rajasthan Palaces</option>
                  <option value="Himalayan Ladakh & Nubra">Himalayan Ladakh & Nubra</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-slate-400 font-semibold mb-1">Travel Dates / Season</label>
              <div class="relative">
                <i data-lucide="calendar" class="w-4 h-4 text-gold-400 absolute left-3 top-3"></i>
                <input type="text" value="Oct 10 – Oct 17, 2026 (7 Days)" readonly class="w-full pl-9 pr-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white cursor-pointer focus:outline-none" />
              </div>
            </div>

            <div>
              <label class="block text-slate-400 font-semibold mb-1">Party & Travel Style</label>
              <div class="relative">
                <i data-lucide="users" class="w-4 h-4 text-gold-400 absolute left-3 top-3"></i>
                <select id="hero-quick-party" class="w-full pl-9 pr-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
                  <option>2 Travelers • Cultural & Heritage</option>
                  <option>Solo Traveler • Photography & Food</option>
                  <option>Family (with kids) • Relaxed Luxury</option>
                  <option>Business & Cross-Border Delegation</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-slate-400 font-semibold mb-1">Estimated Budget (USD)</label>
              <div class="relative">
                <i data-lucide="dollar-sign" class="w-4 h-4 text-gold-400 absolute left-3 top-3"></i>
                <select id="hero-quick-budget" class="w-full pl-9 pr-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
                  <option value="3500">$3,500 (₹2,90,500) • Premium Comfort</option>
                  <option value="5500">$5,500 (₹4,56,500) • Royal Heritage</option>
                  <option value="8500">$8,500+ (₹7,05,500) • Ultra Luxury Private</option>
                  <option value="2000">$2,000 (₹1,66,000) • Value Explorer</option>
