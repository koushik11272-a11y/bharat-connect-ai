  <!-- 13. COMMUNITY SECTION -->
  <!-- ================================================== -->
  <section id="community" class="py-24 bg-navy-950 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block mb-2">Global Community</span>
          <h2 class="font-serif-luxury text-3xl sm:text-4xl font-bold text-white leading-tight">
            Traveler Stories & Discussions
          </h2>
          <p class="mt-2 text-sm text-slate-300 max-w-2xl leading-relaxed">
            Real experiences from travelers who explored India with our verified guides, discovered artisan partners, and navigated with confidence.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 self-start md:self-auto">
          <button onclick="openModal('join-community-modal')" class="px-4 py-2.5 rounded-xl bg-navy-900 border border-gold-500/40 text-gold-400 hover:bg-gold-500 hover:text-navy-950 font-bold text-xs transition-all shadow-md flex items-center gap-1.5">
            <i data-lucide="users" class="w-4 h-4"></i>
            <span>Join Community</span>
          </button>
          <button onclick="openModal('create-post-modal')" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs transition-all flex items-center gap-1.5">
            <i data-lucide="share-2" class="w-4 h-4 text-gold-400"></i>
            <span>Share Experience</span>
          </button>
          <button onclick="openModal('create-post-modal')" class="px-5 py-2.5 rounded-xl bg-gold-500 hover:bg-gold-600 text-navy-950 font-bold text-xs transition-all shadow-md flex items-center gap-1.5">
            <i data-lucide="edit-3" class="w-4 h-4"></i>
            <span>Create Post</span>
          </button>
        </div>
      </div>

      <!-- Community Category Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 text-xs scrollbar-none">
        <button onclick="setCommunityCategory('all', this)" class="community-category-tab px-4 py-2 rounded-xl bg-gold-500 text-navy-950 font-bold whitespace-nowrap transition-all">
          All Discussions
        </button>
        <button onclick="setCommunityCategory('Traveler Stories', this)" class="community-category-tab px-4 py-2 rounded-xl bg-slate-800/80 text-slate-300 hover:text-white whitespace-nowrap transition-all">
