  <!-- ================================================== -->
  <!-- EXPLORE INDIA: FLAGSHIP DESTINATIONS & REGIONAL CIRCUITS -->
  <!-- ================================================== -->
  <section id="explore-india" class="py-24 bg-navy-950 relative border-t border-slate-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-xs font-semibold text-gold-300 mb-3">
          <i data-lucide="compass" class="w-3.5 h-3.5 text-gold-400"></i>
          <span>Curated Circuits for International Travelers</span>
        </div>
        <h2 class="font-serif-luxury text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight">
          Explore India: <span class="text-gold-gradient font-normal italic">Six Iconic Journeys</span>
        </h2>
        <p class="mt-4 text-sm text-slate-300 leading-relaxed max-w-2xl mx-auto">
          From the marble grandeur of the Taj Mahal to the serene backwaters of Kerala and Himalayan monastic high passes—discover our six flagship travel corridors designed for seamless exploration.
        </p>
      </div>

      <!-- 6 Regional Circuit Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Card 1: The Golden Triangle -->
