  <!-- 5. PROBLEM SECTION -->
  <!-- ================================================== -->
  <section class="py-24 bg-navy-900/60 border-y border-slate-800/80 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block mb-2">Addressing Real Travel Friction</span>
        <h2 class="font-serif-luxury text-3xl sm:text-4xl font-bold text-white leading-tight">
          Traveling to India Should Feel Exciting, Not Complicated.
        </h2>
        <p class="mt-4 text-sm text-slate-300 leading-relaxed">
          International travelers often hesitate before visiting India due to disjointed tools, information asymmetry, and lack of verified human networks. Here is how the ecosystem bridges the gap:
        </p>
      </div>

      <!-- 5 Problem Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-5">
        
        <!-- Card 1 -->
        <div class="glass-card rounded-2xl p-6 flex flex-col justify-between hover:border-gold-500/40 transition-all">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/30 flex items-center justify-center text-gold-400 mb-4">
              <i data-lucide="message-square-off" class="w-6 h-6"></i>
            </div>
            <h3 class="font-bold text-white text-base mb-2">1. Language Barriers</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Difficulty communicating with local vendors, transport providers, and rural artisans without trusted bilingual assistance.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800 text-[11px] text-emerald-400 font-semibold">
            ✓ Multilingual Local Guides & Live AI
          </div>
        </div>

        <!-- Card 2 -->
        <div class="glass-card rounded-2xl p-6 flex flex-col justify-between hover:border-gold-500/40 transition-all">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/30 flex items-center justify-center text-gold-400 mb-4">
              <i data-lucide="layers" class="w-6 h-6"></i>
            </div>
            <h3 class="font-bold text-white text-base mb-2">2. Fragmented Bookings</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Flights, trains, heritage hotels, private drivers, and heritage tickets are spread across dozens of conflicting platforms.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800 text-[11px] text-emerald-400 font-semibold">
            ✓ Unified End-to-End Orchestration
          </div>
        </div>

        <!-- Card 3 -->
        <div class="glass-card rounded-2xl p-6 flex flex-col justify-between hover:border-gold-500/40 transition-all">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/30 flex items-center justify-center text-gold-400 mb-4">
              <i data-lucide="shield-question" class="w-6 h-6"></i>
            </div>
            <h3 class="font-bold text-white text-base mb-2">3. Lack of Trust</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Travelers struggle to evaluate authentic services, transparent pricing, and avoid tourist traps without official vetting.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800 text-[11px] text-emerald-400 font-semibold">
            ✓ Government Certified & KYC Verified
          </div>
        </div>

        <!-- Card 4 -->
        <div class="glass-card rounded-2xl p-6 flex flex-col justify-between hover:border-gold-500/40 transition-all">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/30 flex items-center justify-center text-gold-400 mb-4">
              <i data-lucide="shuffle" class="w-6 h-6"></i>
            </div>
            <h3 class="font-bold text-white text-base mb-2">4. Generic Planning</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Most online itineraries are recycled cookie-cutter lists that ignore personal pace, dietary preferences, and travel party safety.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800 text-[11px] text-emerald-400 font-semibold">
            ✓ Precision AI Tailoring by Traveler
          </div>
        </div>

        <!-- Card 5 -->
        <div class="glass-card rounded-2xl p-6 flex flex-col justify-between hover:border-gold-500/40 transition-all">
          <div>
            <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/30 flex items-center justify-center text-gold-400 mb-4">
              <i data-lucide="unlink" class="w-6 h-6"></i>
            </div>
            <h3 class="font-bold text-white text-base mb-2">5. Limited Long-Term Connection</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              The relationship between international travelers and local communities abruptly terminates the moment the airplane departs.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800 text-[11px] text-emerald-400 font-semibold">
            ✓ Global Collaboration Lounge
          </div>
        </div>

      </div>

      <!-- Problem Section Closing Statement -->
      <div class="mt-12 text-center">
        <div class="inline-block px-6 py-3 rounded-2xl bg-navy-950 border border-gold-500/40 text-sm font-semibold text-white shadow-xl">
          <span class="sr-only">BharatConnect AI brings the entire journey into one connected ecosystem.</span>
          <span class="text-gold-400">BharatConnect AI</span> brings the entire journey into one connected ecosystem.
        </div>
      </div>

    </div>
  </section>

  <!-- ================================================== -->
  <!-- 6. AI TRIP PLANNER -->
  <!-- ================================================== -->
  <section id="ai-trip-planner" class="py-24 bg-navy-950 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block mb-2">Intelligent Engine</span>
        <h2 class="font-serif-luxury text-3xl sm:text-4xl font-bold text-white leading-tight">
          AI Trip Planner
        </h2>
        <p class="mt-3 text-sm text-slate-300 leading-relaxed">
          Configure your travel profile below. Our neural engine synthesizes real-time seasonal data, certified local guide availability, and verified havelis into an actionable, transparent itinerary.
        </p>
      </div>

      <!-- Planner Form Container -->
      <div class="glass-panel rounded-3xl p-6 sm:p-10 border-gold-500/30 max-w-5xl mx-auto">
        
        <!-- Planner Mode Selection Tabs -->
        <div class="mb-10">
          <div class="text-center mb-6">
            <span class="text-xs uppercase tracking-wider text-gold-400 font-bold block mb-1">Two Intelligent Planning Modes</span>
            <h3 class="text-xl font-bold text-white">Choose How You Want to Build Your Journey</h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl mx-auto">
            
            <!-- Option 1: AI Planner Card -->
            <button type="button" id="mode-btn-ai" onclick="switchPlannerMode('ai')" class="relative p-5 rounded-2xl border-2 transition-all duration-300 text-left border-gold-500 bg-gold-500/10 shadow-lg shadow-gold-500/10 group cursor-pointer">
              <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-gold-500/20 border border-gold-500/40 flex items-center justify-center text-xl">
                  🤖
                </div>
                <span id="mode-badge-ai" class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wide bg-gold-500 text-navy-950">
                  Active Choice
                </span>
              </div>
              <h4 class="text-base font-bold text-white group-hover:text-gold-300 transition-colors">
                OPTION 1 — 🤖 Let AI Plan My Trip
              </h4>
              <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
                Provide basic information (destination, days, travelers, budget, interests, style) and BharatConnect AI automatically generates a complete personalized day-by-day itinerary.
              </p>
              <div class="mt-3 flex flex-wrap gap-1.5 text-[10px] text-gold-300/90 font-medium">
                <span class="px-2 py-0.5 rounded bg-slate-900/60 border border-gold-500/20">✨ Automated Neural Curation</span>
                <span class="px-2 py-0.5 rounded bg-slate-900/60 border border-gold-500/20">⚡ 1-Click Generation</span>
              </div>
            </button>

            <!-- Option 2: Customize Plan Card -->
            <button type="button" id="mode-btn-custom" onclick="switchPlannerMode('custom')" class="relative p-5 rounded-2xl border-2 transition-all duration-300 text-left border-slate-800 bg-slate-900/60 hover:border-gold-500/50 hover:bg-slate-900/90 group cursor-pointer">
              <div class="flex items-start justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-xl group-hover:border-gold-500/40">
                  ✏️
                </div>
                <span id="mode-badge-custom" class="hidden px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wide bg-gold-500 text-navy-950">
                  Active Choice
                </span>
              </div>
              <h4 class="text-base font-bold text-white group-hover:text-gold-300 transition-colors">
                OPTION 2 — ✏️ Customize My Plan
              </h4>
              <p class="text-xs text-slate-300 mt-1.5 leading-relaxed">
                Create your own itinerary with bespoke control: select destinations, places to visit, authentic activities, verified local guides, lodging, transit, and daily schedule pace.
              </p>
              <div class="mt-3 flex flex-wrap gap-1.5 text-[10px] text-slate-400 font-medium">
                <span class="px-2 py-0.5 rounded bg-slate-900/60 border border-slate-800">🎯 Bespoke Selection</span>
                <span class="px-2 py-0.5 rounded bg-slate-900/60 border border-slate-800">🛠️ Tailored Schedule</span>
              </div>
            </button>

          </div>
        </div>

        <form id="ai-planner-form" onsubmit="handleTripPlanSubmit(event)" class="space-y-8">
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            
            <!-- Origin Country -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="globe" class="w-3.5 h-3.5 text-gold-400"></i> Starting Country
              </label>
              <select id="planner-origin" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="United States" selected>United States (USA)</option>
                <option value="United Kingdom">United Kingdom (UK)</option>
                <option value="Canada">Canada</option>
                <option value="Australia">Australia</option>
                <option value="Germany">Germany</option>
                <option value="France">France</option>
                <option value="Other">Other Global Traveler</option>
              </select>
            </div>

            <!-- Destination in India -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="map-pin" class="w-3.5 h-3.5 text-gold-400"></i> Destination in India
              </label>
              <select id="planner-destination" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="Golden Triangle (Delhi, Agra, Jaipur)" selected>Golden Triangle (Delhi, Agra, Jaipur)</option>
                <option value="Kerala Backwaters & Spice Coast">Kerala Backwaters & Spice Coast</option>
                <option value="Varanasi & Sacred North">Varanasi & Sacred North</option>
                <option value="Royal Rajasthan (Jaipur, Jodhpur, Udaipur)">Royal Rajasthan (Jaipur, Jodhpur, Udaipur)</option>
                <option value="Ladakh & High Himalayas">Ladakh & High Himalayas</option>
                <option value="South India Temple & Heritage Corridor">South India Temple & Heritage Corridor</option>
              </select>
            </div>

            <!-- Duration -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="clock" class="w-3.5 h-3.5 text-gold-400"></i> Duration (Days)
              </label>
              <select id="planner-duration" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="5">5 Days (Express Highlights)</option>
                <option value="7" selected>7 Days (Recommended Classic)</option>
                <option value="10">10 Days (Comprehensive Discovery)</option>
                <option value="14">14 Days (Grand Immersion)</option>
              </select>
            </div>

            <!-- Travelers Count -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="users" class="w-3.5 h-3.5 text-gold-400"></i> Number of Travelers
              </label>
              <select id="planner-travelers" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="1">1 Solo Traveler</option>
                <option value="2" selected>2 Travelers</option>
                <option value="3">3 Travelers</option>
                <option value="4">4 Travelers (Family / Group)</option>
                <option value="6">6+ Travelers (Private Delegation)</option>
              </select>
            </div>

            <!-- Traveler Type -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="user-check" class="w-3.5 h-3.5 text-gold-400"></i> Traveler Profile
              </label>
              <select id="planner-traveler-type" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="Couple" selected>Couple / Partners</option>
                <option value="Solo Traveler">Solo Adventurer</option>
                <option value="Family with Children">Family with Children</option>
                <option value="Senior Travelers">Senior / Multigenerational</option>
                <option value="Business & Leisure">Business & Leisure (Bleisure)</option>
              </select>
            </div>

            <!-- Budget Range (USD) -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="wallet" class="w-3.5 h-3.5 text-gold-400"></i> Total Target Budget (USD)
              </label>
              <select id="planner-budget" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="2000">$2,000 (~₹1,66,000) • Quality Explorer</option>
                <option value="3500" selected>$3,500 (~₹2,90,500) • Premium Heritage</option>
                <option value="5500">$5,500 (~₹4,56,500) • Palace Luxury</option>
                <option value="9000">$9,000 (~₹7,47,000) • Bespoke Ultra-VIP</option>
              </select>
            </div>

            <!-- Travel Style -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="compass" class="w-3.5 h-3.5 text-gold-400"></i> Travel Style
              </label>
              <select id="planner-style" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="Cultural" selected>Cultural & Heritage</option>
                <option value="Adventure">Adventure & Wildlife</option>
                <option value="Luxury">Royal Luxury & Wellness</option>
                <option value="Family">Family Friendly</option>
                <option value="Spiritual">Spiritual & Mindful</option>
                <option value="Food and Experiences">Food & Culinary Trails</option>
                <option value="Business Travel">Business & Cross-Border</option>
              </select>
            </div>

            <!-- Preferred Language -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="languages" class="w-3.5 h-3.5 text-gold-400"></i> Guide Language
              </label>
              <select id="planner-language" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="English" selected>English</option>
                <option value="Spanish">Spanish</option>
                <option value="French">French</option>
                <option value="German">German</option>
                <option value="Hindi">Hindi / Bilingual</option>
              </select>
            </div>

            <!-- Accommodation Preferences -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="hotel" class="w-3.5 h-3.5 text-gold-400"></i> Lodging Preference
              </label>
              <select id="planner-lodging" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="Heritage Haveli & Boutique" selected>Heritage Havelis & Historic Palaces</option>
                <option value="5-Star Luxury Hotels">5-Star Luxury (Taj / Oberoi / ITC)</option>
                <option value="Eco-Resorts & Tea Estates">Eco-Resorts & Forest Lodges</option>
                <option value="Boutique Homestays">Boutique Homestays with Local Hosts</option>
              </select>
            </div>

          </div>

          <!-- Interests Tags Checkboxes -->
          <div>
            <label class="block font-bold text-slate-300 text-xs mb-2">Interests & Focus Areas (Select all that apply):</label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
              <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="interests" value="Heritage Architecture" checked class="accent-gold-500 rounded" />
                <span class="text-slate-300">Heritage Architecture</span>
              </label>
              <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="interests" value="Street & Royal Food" checked class="accent-gold-500 rounded" />
                <span class="text-slate-300">Street & Royal Food</span>
              </label>
              <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="interests" value="Handicrafts & Textiles" checked class="accent-gold-500 rounded" />
                <span class="text-slate-300">Handicrafts & Textiles</span>
              </label>
              <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="interests" value="Yoga & Ayurveda" class="accent-gold-500 rounded" />
                <span class="text-slate-300">Yoga & Ayurveda</span>
              </label>
              <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="interests" value="Photography Trails" class="accent-gold-500 rounded" />
                <span class="text-slate-300">Photography Trails</span>
              </label>
              <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="interests" value="Wildlife & Tigers" class="accent-gold-500 rounded" />
                <span class="text-slate-300">Wildlife & Tigers</span>
              </label>
              <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="interests" value="Business Alliances" class="accent-gold-500 rounded" />
                <span class="text-slate-300">Business Alliances</span>
              </label>
              <label class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="interests" value="Spiritual Rituals" class="accent-gold-500 rounded" />
                <span class="text-slate-300">Spiritual Rituals</span>
              </label>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="pt-4 flex justify-center">
            <button type="submit" class="px-8 py-4 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 text-navy-950 font-extrabold text-sm shadow-xl shadow-gold-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center gap-2">
              <i data-lucide="sparkles" class="w-4 h-4 text-navy-950"></i>
              <span>Generate AI-Curated Itinerary</span>
            </button>
          </div>

        </form>

        <!-- Option 2: Customize My Plan Form -->
        <form id="custom-planner-form" onsubmit="handleCustomPlanSubmit(event)" class="space-y-8 hidden">
          
          <div class="p-4 rounded-2xl bg-gold-500/10 border border-gold-500/30 flex items-center gap-3">
            <span class="text-2xl">✏️</span>
            <div>
              <h4 class="text-xs font-bold text-white uppercase tracking-wider">Bespoke Trip Customizer</h4>
              <p class="text-xs text-slate-300 mt-0.5">Customize your destinations, hand-pick your certified local guide, select authentic experiences, and specify your daily schedule pace.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
            
            <!-- Custom Destination -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="map-pin" class="w-3.5 h-3.5 text-gold-400"></i> Destination / Region
              </label>
              <select id="custom-destination" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="Golden Triangle (Delhi, Agra, Jaipur)" selected>Golden Triangle (Delhi, Agra, Jaipur)</option>
                <option value="Royal Rajasthan (Jaipur, Jodhpur, Udaipur)">Royal Rajasthan (Jaipur, Jodhpur, Udaipur)</option>
                <option value="Kerala Backwaters & Spice Coast">Kerala Backwaters & Spice Coast</option>
                <option value="Varanasi & Sacred North">Varanasi & Sacred North</option>
                <option value="Ladakh & High Himalayas">Ladakh & High Himalayas</option>
                <option value="South India Temple & Heritage Corridor">South India Temple & Heritage Corridor</option>
                <option value="Mumbai & Western Coast">Mumbai & Western Coast</option>
              </select>
            </div>

            <!-- Custom Duration -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="clock" class="w-3.5 h-3.5 text-gold-400"></i> Duration (Days)
              </label>
              <select id="custom-duration" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="3">3 Days (Express Weekend)</option>
                <option value="5">5 Days (Key Highlights)</option>
                <option value="7" selected>7 Days (Recommended Classic)</option>
                <option value="10">10 Days (Comprehensive Discovery)</option>
                <option value="14">14 Days (Grand Immersion)</option>
              </select>
            </div>

            <!-- Custom Travelers -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="users" class="w-3.5 h-3.5 text-gold-400"></i> Travelers Count
              </label>
              <select id="custom-travelers" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="1">1 Solo Traveler</option>
                <option value="2" selected>2 Travelers</option>
                <option value="3">3 Travelers</option>
                <option value="4">4 Travelers (Family / Group)</option>
                <option value="6">6+ Travelers (Private Group)</option>
              </select>
            </div>

            <!-- Custom Traveler Type -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="user-check" class="w-3.5 h-3.5 text-gold-400"></i> Traveler Profile
              </label>
              <select id="custom-traveler-type" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="Couple" selected>Couple / Partners</option>
                <option value="Solo Traveler">Solo Adventurer</option>
                <option value="Family with Children">Family with Children</option>
                <option value="Senior Travelers">Senior / Multigenerational</option>
                <option value="Business & Leisure">Business & Leisure</option>
              </select>
            </div>

            <!-- Custom Budget -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="wallet" class="w-3.5 h-3.5 text-gold-400"></i> Total Target Budget (USD)
              </label>
              <select id="custom-budget" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="2000">$2,000 (~₹1,66,000) • Quality Explorer</option>
                <option value="3500" selected>$3,500 (~₹2,90,500) • Premium Heritage</option>
                <option value="5500">$5,500 (~₹4,56,500) • Palace Luxury</option>
                <option value="9000">$9,000 (~₹7,47,000) • Bespoke Ultra-VIP</option>
              </select>
            </div>

            <!-- Custom Daily Schedule / Pace -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="activity" class="w-3.5 h-3.5 text-gold-400"></i> Daily Schedule & Pace
              </label>
              <select id="custom-pace" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="Balanced (2-3 Sights Daily)" selected>Balanced (2-3 Sights Daily + Afternoon Leisure)</option>
                <option value="Relaxed & Mindful (1-2 Key Highlights)">Relaxed & Mindful (1-2 Highlights + Wellness/Tea)</option>
                <option value="Active Explorer (Intensive Full Days)">Active Explorer (Full Days, Sunrise to Night Trails)</option>
              </select>
            </div>

            <!-- Select Specific Verified Local Guide -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="user" class="w-3.5 h-3.5 text-gold-400"></i> Select Local Guide
              </label>
              <select id="custom-guide" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="">-- Let BharatConnect Match the Best Guide --</option>
                <option value="guide-1" selected>Arjun Sharma (Jaipur / Rajasthan • Culture & Havelis)</option>
                <option value="guide-2">Priya Nair (Kochi / Kerala • Food & Backwaters)</option>
                <option value="guide-3">Vikramaditya Sengupta (Varanasi • Sacred Ghats & Philosophy)</option>
                <option value="guide-4">Kabir Khan (New Delhi • Mughal History & Street Food)</option>
                <option value="guide-5">Ananya Kulkarni (Mumbai • Trade, Art Deco & Alliances)</option>
                <option value="guide-6">Rajesh Kumar (Agra • Taj Mahal & Mughal Stonemasons)</option>
              </select>
            </div>

            <!-- Custom Accommodation Preference -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="hotel" class="w-3.5 h-3.5 text-gold-400"></i> Lodging Style
              </label>
              <select id="custom-lodging" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="Heritage Haveli & Boutique" selected>Heritage Havelis & Restored Palaces</option>
                <option value="5-Star Luxury Hotels">5-Star Luxury (Taj / Oberoi / ITC)</option>
                <option value="Eco-Resorts & Tea Estates">Eco-Resorts & Forest Lodges</option>
                <option value="Boutique Homestays">Boutique Homestays with Local Hosts</option>
              </select>
            </div>

            <!-- Custom Transportation Preference -->
            <div>
              <label class="block font-bold text-slate-300 mb-1.5 flex items-center gap-1.5">
                <i data-lucide="car" class="w-3.5 h-3.5 text-gold-400"></i> Transportation Mode
              </label>
              <select id="custom-transport" class="w-full px-3.5 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium focus:outline-none focus:border-gold-500">
                <option value="Private Chauffeur & High-speed Rail" selected>Private Chauffeur Sedan & Vande Bharat Rail</option>
                <option value="Private Chauffeur Luxury SUV">Private Chauffeur Luxury SUV (Full Route)</option>
                <option value="Executive Flight & Private Transfer">Domestic Flights + Private Airport Chauffeur</option>
                <option value="Heritage Rail & Scenic Road">Scenic Heritage Trains & Local Private Van</option>
              </select>
            </div>

          </div>

          <!-- Hand-picked Experiences Checkboxes -->
          <div>
            <label class="block font-bold text-slate-300 text-xs mb-2">
              Select Specific Authentic Experiences & Activities to Include:
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs">
              
              <label class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="custom_experiences" value="exp-1" checked class="accent-gold-500 rounded mt-0.5" />
                <div>
                  <span class="font-bold text-white block">Traditional Cooking Masterclass</span>
                  <span class="text-[11px] text-slate-400">Jaipur • Haveli Courtyard Feast</span>
                </div>
              </label>

              <label class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="custom_experiences" value="exp-2" checked class="accent-gold-500 rounded mt-0.5" />
                <div>
                  <span class="font-bold text-white block">Old Delhi Heritage Walking Tour</span>
                  <span class="text-[11px] text-slate-400">Delhi • Mughal Citadel & Spices</span>
                </div>
              </label>

              <label class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="custom_experiences" value="exp-3" class="accent-gold-500 rounded mt-0.5" />
                <div>
                  <span class="font-bold text-white block">Historic Spice Warehouse Walk</span>
                  <span class="text-[11px] text-slate-400">Kochi • Ancient Pepper Exchange</span>
                </div>
              </label>

              <label class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="custom_experiences" value="exp-4" class="accent-gold-500 rounded mt-0.5" />
                <div>
                  <span class="font-bold text-white block">Backwaters Village Immersion</span>
                  <span class="text-[11px] text-slate-400">Alleppey • Paddy Farming & Canoe</span>
                </div>
              </label>

              <label class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="custom_experiences" value="exp-5" class="accent-gold-500 rounded mt-0.5" />
                <div>
                  <span class="font-bold text-white block">Artisan Block Printing Workshop</span>
                  <span class="text-[11px] text-slate-400">Bagru / Jaipur • Natural Dyes</span>
                </div>
              </label>

              <label class="flex items-start gap-2.5 p-3 rounded-xl bg-slate-900 border border-slate-800 hover:border-gold-500/40 cursor-pointer">
                <input type="checkbox" name="custom_experiences" value="exp-6" class="accent-gold-500 rounded mt-0.5" />
                <div>
                  <span class="font-bold text-white block">Varanasi Sunrise Boat Chants</span>
                  <span class="text-[11px] text-slate-400">Varanasi • Sacred Morning Ragas</span>
                </div>
              </label>

            </div>
          </div>

          <!-- Must-Visit Spots & Custom Notes -->
          <div>
            <label class="block font-bold text-slate-300 text-xs mb-1.5 flex items-center gap-1.5">
              <i data-lucide="edit-3" class="w-3.5 h-3.5 text-gold-400"></i> Specific Must-Visit Sights, Places or Special Requests
            </label>
            <textarea id="custom-notes" rows="2" placeholder="e.g., Must include sunrise at Taj Mahal, interested in organic vegetarian food, need wheelchair accessible transport, private sitar recital..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white font-medium text-xs focus:outline-none focus:border-gold-500"></textarea>
          </div>

          <!-- Submit Button -->
          <div class="pt-4 flex justify-center">
            <button type="submit" class="px-8 py-4 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 text-navy-950 font-extrabold text-sm shadow-xl shadow-gold-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center gap-2">
              <i data-lucide="sliders" class="w-4 h-4 text-navy-950"></i>
              <span>Assemble My Custom Itinerary</span>
            </button>
          </div>

        </form>

        <!-- Dynamic AI Generation Loader -->
        <div id="planner-loading-overlay" class="hidden my-8 p-8 rounded-2xl bg-navy-900/90 border border-gold-500/30 text-center animate-shimmer">
          <div class="w-12 h-12 rounded-full border-4 border-gold-500 border-t-transparent animate-spin mx-auto mb-4"></div>
          <h4 class="text-base font-bold text-white mb-2">BharatConnect Neural Engine is Assembling Your Plan...</h4>
          <p id="planner-loading-step" class="text-xs text-gold-300 font-medium">Evaluating regional seasonality & festival calendars...</p>
          <div class="w-64 h-1.5 bg-slate-800 rounded-full mx-auto mt-4 overflow-hidden">
            <div id="planner-progress-bar" class="h-full bg-gold-500 transition-all duration-300" style="width: 20%;"></div>
          </div>
        </div>

        <!-- Generated Itinerary Result Container -->
        <div id="planner-result-container" class="hidden mt-12 pt-8 border-t border-slate-800/80 space-y-8">
          
          <!-- Itinerary Header -->
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-800">
            <div>
              <div id="itinerary-meta" class="flex flex-wrap items-center gap-2 mb-2"></div>
              <h3 id="itinerary-title" class="font-serif-luxury text-2xl sm:text-3xl font-bold text-white"></h3>
            </div>

            <!-- Action Buttons: Save, Edit, Share, Request Local Assistance, Export -->
            <div class="flex flex-wrap items-center gap-2 no-print">
              <button id="save-trip-plan-btn" onclick="saveCurrentItinerary()" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 flex items-center gap-1.5 transition-colors" title="Save trip to your account">
                <i data-lucide="bookmark" id="save-btn-icon" class="w-3.5 h-3.5 text-gold-400"></i>
                <span id="save-btn-text">Save Trip Plan</span>
              </button>
              <button onclick="editTripPlan()" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 flex items-center gap-1.5 transition-colors" title="Edit travel parameters">
                <i data-lucide="edit-3" class="w-3.5 h-3.5 text-gold-400"></i> Edit Plan
              </button>
              <button onclick="shareCurrentItinerary()" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 flex items-center gap-1.5 transition-colors" title="Share plan">
                <i data-lucide="share-2" class="w-3.5 h-3.5 text-gold-400"></i> Share Plan
              </button>
              <button onclick="printCurrentItinerary()" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 flex items-center gap-1.5 transition-colors" title="Print / Export PDF">
                <i data-lucide="printer" class="w-3.5 h-3.5 text-gold-400"></i> Export PDF
              </button>
              <button onclick="openModal('local-assistance-modal')" class="px-4 py-2 rounded-xl bg-gold-500 hover:bg-gold-600 text-navy-950 text-xs font-bold flex items-center gap-1.5 transition-all shadow-md">
                <i data-lucide="user-check" class="w-3.5 h-3.5"></i> Request Local Assistance
              </button>
            </div>
          </div>

          <!-- Budget Breakdown Visualization -->
          <div class="p-5 rounded-2xl bg-[#0E2547]/60 border border-gold-500/20">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-800/80 mb-3 text-xs">
              <span class="font-bold text-white flex items-center gap-1.5">
                <i data-lucide="pie-chart" class="w-4 h-4 text-gold-400"></i> Estimated Total Budget Allocation
              </span>
              <span class="text-gold-400 font-extrabold text-base" id="itinerary-total-cost">$3,500</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
              <div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-800">
                <span class="text-slate-400 block text-[11px]">Lodging & Palaces</span>
                <span class="font-bold text-white" id="itinerary-lodging-cost">$1,400</span>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-800">
                <span class="text-slate-400 block text-[11px]">Private Chauffeur & Rail</span>
                <span class="font-bold text-white" id="itinerary-transit-cost">$770</span>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-800">
                <span class="text-slate-400 block text-[11px]">Verified Guides & Tours</span>
                <span class="font-bold text-white" id="itinerary-guides-cost">$700</span>
              </div>
              <div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-800">
                <span class="text-slate-400 block text-[11px]">Curated Food & Reserve</span>
                <span class="font-bold text-white" id="itinerary-dining-cost">$630</span>
              </div>
            </div>
          </div>

          <!-- Day-by-Day Schedule -->
          <div>
            <h4 class="text-base font-bold text-white mb-4 flex items-center gap-2">
              <i data-lucide="calendar" class="w-4 h-4 text-gold-400"></i> Day-by-Day Itemized Schedule
            </h4>
            <div id="itinerary-days-list" class="space-y-4"></div>
          </div>

          <!-- Matched Verified Guides and Curated Experiences -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
            <div>
              <h4 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
                <i data-lucide="user-check" class="w-4 h-4 text-gold-400"></i> Recommended Verified Guides for this Route
              </h4>
              <div id="itinerary-matched-guides" class="space-y-3"></div>
            </div>
            <div>
              <h4 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
                <i data-lucide="compass" class="w-4 h-4 text-gold-400"></i> Matched Authentic Local Experiences
              </h4>
              <div id="itinerary-matched-exp" class="space-y-3"></div>
            </div>
          </div>

          <!-- Safety, Etiquette & Travel Tips -->
          <div class="p-5 rounded-2xl bg-slate-900/70 border border-slate-800">
            <h4 class="text-xs font-bold text-gold-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
              <i data-lucide="shield" class="w-4 h-4 text-gold-400"></i> Curated Safety, Health & Cultural Etiquette Tips
            </h4>
            <ul id="itinerary-safety-tips" class="space-y-2"></ul>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- ================================================== -->
  <!-- 6B. MY TRIPS DASHBOARD -->
  <!-- ================================================== -->
  <section id="my-trips" class="py-24 bg-navy-900/80 border-b border-slate-800/80 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block mb-2">Authenticated Travel Hub</span>
          <h2 class="font-serif-luxury text-3xl sm:text-4xl font-bold text-white leading-tight">
            My Saved Trips
          </h2>
          <p class="mt-2 text-sm text-slate-300 max-w-2xl leading-relaxed">
            Access, review, or customize your saved BharatConnect AI itineraries anytime. Every trip plan is associated with your authenticated session.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a href="#ai-trip-planner" onclick="resetAndFocusPlanner()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 text-navy-950 font-bold text-xs shadow-lg shadow-gold-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-1.5">
            <i data-lucide="plus" class="w-4 h-4 text-navy-950"></i>
            <span>Create Another Trip</span>
          </a>
        </div>
      </div>

      <!-- Empty State Container (shown when no saved trips) -->
      <div id="my-trips-empty" class="p-12 text-center rounded-3xl bg-slate-900/50 border border-slate-800 max-w-2xl mx-auto">
        <div class="w-16 h-16 rounded-2xl bg-gold-500/10 border border-gold-500/30 flex items-center justify-center mx-auto mb-4 text-gold-400">
          <i data-lucide="compass" class="w-8 h-8"></i>
        </div>
        <h3 class="text-lg font-bold text-white mb-2">No Saved Trips Yet</h3>
        <p class="text-xs text-slate-400 leading-relaxed max-w-md mx-auto mb-6">
          You haven't saved any travel itineraries yet. Use our AI Planner or Customizer to build and save your personalized India journey.
        </p>
        <a href="#ai-trip-planner" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gold-500 text-navy-950 font-bold text-xs shadow-lg shadow-gold-500/20 hover:bg-gold-400 transition-all">
          <i data-lucide="sparkles" class="w-4 h-4"></i>
          <span>Plan Your First Trip Now</span>
        </a>
      </div>

      <!-- Saved Trips Grid Container -->
      <div id="my-trips-grid" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Dynamically rendered trip cards go here via renderUserTrips() -->
      </div>

      <!-- Bottom Banner for quick action -->
      <div id="my-trips-footer" class="hidden mt-12 p-6 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gold-500/10 border border-gold-500/30 flex items-center justify-center text-gold-400">
            <i data-lucide="sparkles" class="w-5 h-5"></i>
          </div>
          <div>
            <h4 class="text-sm font-bold text-white">Ready for a new adventure?</h4>
            <p class="text-xs text-slate-400">Generate another tailored itinerary or customize a new route across India.</p>
          </div>
        </div>
        <a href="#ai-trip-planner" onclick="resetAndFocusPlanner()" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-gold-400 text-xs font-bold border border-slate-700 flex items-center gap-1.5 transition-all">
          <i data-lucide="plus-circle" class="w-4 h-4"></i>
          <span>Plan Another Trip</span>
        </a>
      </div>

    </div>
  </section>

  <!-- ================================================== -->
  <!-- 7. BEFORE, DURING, AND AFTER TRAVEL -->
  <!-- ================================================== -->
  <section class="py-24 bg-navy-900/60 border-y border-slate-800/80 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block mb-2">End-to-End Care</span>
        <h2 class="font-serif-luxury text-3xl sm:text-4xl font-bold text-white leading-tight">
          Your 3-Stage Connected Journey
        </h2>
        <p class="mt-3 text-sm text-slate-300 leading-relaxed">
          BharatConnect AI supports you before you board your flight, guides you during every step on the ground, and preserves your connections long after your trip.
        </p>
      </div>

      <!-- Horizontal 3-Stage Timeline Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        
        <!-- Stage 1: Before Travel -->
        <div class="glass-card rounded-3xl p-8 border-gold-500/20 hover:border-gold-500/50 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="px-3 py-1 rounded-full bg-gold-500/20 text-gold-300 font-bold text-xs uppercase tracking-wider">
                Stage 1
              </span>
              <i data-lucide="plane-takeoff" class="w-6 h-6 text-gold-400"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">BEFORE TRAVEL</h3>
            <p class="text-xs text-slate-300 mb-6 leading-relaxed">
              Eliminate guesswork with AI-optimized routing, packing checklists, and language preparation.
            </p>

            <ul class="space-y-3 text-xs text-slate-300">
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Personalized AI Itinerary Planning</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Transparent Budget & Currency Optimization</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Destination & Haveli Discovery</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Language & Cultural Etiquette Preparation</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Digital Visa & Packing Checklist</span>
              </li>
            </ul>
          </div>

          <button onclick="openModal('packing-checklist-modal')" class="mt-8 w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold text-white transition-colors flex items-center justify-center gap-1.5">
            <i data-lucide="clipboard-list" class="w-3.5 h-3.5 text-gold-400"></i>
            <span>Open Pre-Travel Checklist</span>
          </button>
        </div>

        <!-- Stage 2: During Travel -->
        <div class="glass-card rounded-3xl p-8 border-gold-500/40 gold-border-glow flex flex-col justify-between relative bg-navy-900/90">
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-gold-500 text-navy-950 text-[10px] font-extrabold uppercase tracking-widest">
            On-The-Ground Care
          </div>

          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="px-3 py-1 rounded-full bg-gold-500/20 text-gold-300 font-bold text-xs uppercase tracking-wider">
                Stage 2
              </span>
              <i data-lucide="map" class="w-6 h-6 text-gold-400"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">DURING TRAVEL</h3>
            <p class="text-xs text-slate-300 mb-6 leading-relaxed">
              Navigate confidently with verified local guides, live translation, and 24/7 tourist safety support.
            </p>

            <ul class="space-y-3 text-xs text-slate-300">
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Verified Licensed Local Guides</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Live 24/7 AI Cultural & Language Assistance</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Private Chauffeur & Rail Transit Telemetry</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Dynamic Real-Time Itinerary Adjustments</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Immediate Emergency SOS Helpline Integration</span>
              </li>
            </ul>
          </div>

          <button onclick="toggleEmergencyDrawer()" class="mt-8 w-full py-2.5 rounded-xl bg-gold-500 hover:bg-gold-600 text-navy-950 text-xs font-bold transition-colors flex items-center justify-center gap-1.5 shadow-lg shadow-gold-500/20">
            <i data-lucide="shield-alert" class="w-3.5 h-3.5"></i>
            <span>Emergency & Assistance Hub</span>
          </button>
        </div>

        <!-- Stage 3: After Travel -->
        <div class="glass-card rounded-3xl p-8 border-gold-500/20 hover:border-gold-500/50 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="px-3 py-1 rounded-full bg-gold-500/20 text-gold-300 font-bold text-xs uppercase tracking-wider">
                Stage 3
              </span>
              <i data-lucide="heart-handshake" class="w-6 h-6 text-gold-400"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">AFTER TRAVEL</h3>
            <p class="text-xs text-slate-300 mb-6 leading-relaxed">
              Turn memories into lifelong connections, business collaborations, and community advocacy.
            </p>

            <ul class="space-y-3 text-xs text-slate-300">
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Submit Feedback & Rate Guides</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Join Global Traveler Community Feed</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Share Stories & Travel Photography</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Cross-Border Business Matchmaking</span>
              </li>
              <li class="flex items-center gap-2.5">
                <i data-lucide="check" class="w-4 h-4 text-gold-400 shrink-0"></i>
                <span>Become an India Travel Ambassador</span>
              </li>
            </ul>
          </div>

          <button onclick="openModal('ambassador-modal')" class="mt-8 w-full py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-bold text-white transition-colors flex items-center justify-center gap-1.5">
            <i data-lucide="award" class="w-3.5 h-3.5 text-gold-400"></i>
            <span>Join Ambassador Program</span>
          </button>
        </div>

      </div>

    </div>
  </section>

  <!-- ================================================== -->
  <!-- 8. VERIFIED LOCAL GUIDES -->
  <!-- ================================================== -->
  <section id="local-guides" class="py-24 bg-navy-950 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block mb-2">Human Expertise</span>
          <h2 class="font-serif-luxury text-3xl sm:text-4xl font-bold text-white leading-tight">
            Verified Local Guides
          </h2>
          <p class="mt-2 text-sm text-slate-300 max-w-2xl leading-relaxed">
            Every guide is identity-verified, licensed by the Ministry of Tourism, and reviewed by international travelers. Experience India through authentic local storytellers.
          </p>
        </div>

        <div class="flex items-center gap-2 text-xs text-gold-300 bg-navy-900 border border-gold-500/30 px-3.5 py-2 rounded-xl">
          <i data-lucide="shield-check" class="w-4 h-4 text-gold-400"></i>
          <span>100% Background Checked & Audited</span>
        </div>
      </div>

      <!-- Verification Quality Assurance Statement -->
      <div class="p-4 rounded-2xl bg-[#0E2547]/50 border border-gold-500/20 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl bg-gold-500/20 text-gold-400 flex items-center justify-center shrink-0">
            <i data-lucide="shield-check" class="w-4 h-4"></i>
          </div>
          <p class="text-slate-300 leading-relaxed">
            <strong class="text-gold-400">Quality & Safety Guarantee:</strong> All BharatConnect guides undergo an intensive 4-stage audit: Ministry of Tourism license validation, biometric police background checks, conversational English fluency testing, and ongoing traveler reviews.
          </p>
        </div>
        <span class="text-[11px] font-bold text-emerald-400 shrink-0 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/30">
          ✓ Govt of India Audited
        </span>
      </div>

      <!-- Filters Bar -->
      <div class="glass-card rounded-2xl p-5 mb-10 text-xs space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-3">
          
          <!-- City Filter -->
          <div>
            <label class="block text-slate-400 font-semibold mb-1">City / Region</label>
            <select id="guide-filter-city" onchange="renderGuides()" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
              <option value="all">All Destinations</option>
              <option value="Jaipur">Jaipur (Rajasthan)</option>
              <option value="New Delhi">New Delhi</option>
              <option value="Kochi">Kochi (Kerala)</option>
              <option value="Varanasi">Varanasi</option>
              <option value="Mumbai">Mumbai</option>
              <option value="Leh">Leh (Ladakh)</option>
              <option value="Bengaluru">Bengaluru</option>
            </select>
          </div>

          <!-- Language Filter -->
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Spoken Language</label>
            <select id="guide-filter-lang" onchange="renderGuides()" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
              <option value="all">All Languages</option>
              <option value="English">English</option>
              <option value="Spanish">Spanish</option>
              <option value="French">French</option>
              <option value="German">German</option>
              <option value="Italian">Italian</option>
            </select>
          </div>

          <!-- Experience Category -->
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Experience Type</label>
            <select id="guide-filter-category" onchange="renderGuides()" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
              <option value="all">All Specialties</option>
              <option value="Cultural">Cultural & Heritage</option>
              <option value="Food">Food & Culinary</option>
              <option value="Spiritual">Spiritual & Sacred</option>
              <option value="Adventure">Adventure & Nature</option>
              <option value="Family">Family Travel Guides</option>
              <option value="Business">Business Travel Assistants</option>
            </select>
          </div>

          <!-- Price Range Filter -->
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Price Range</label>
            <select id="guide-filter-price" onchange="renderGuides()" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
              <option value="all">Any Daily Rate</option>
              <option value="under50">Under $50/day (&lt; ₹4,150)</option>
              <option value="50to75">$50 – $75/day</option>
              <option value="above75">$75+/day (Master Historians)</option>
            </select>
          </div>

          <!-- Rating Filter -->
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Traveler Rating</label>
            <select id="guide-filter-rating" onchange="renderGuides()" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
              <option value="all">All Ratings</option>
              <option value="4.9">4.90+ Stars</option>
              <option value="4.95">4.95+ Stars (Top 5%)</option>
            </select>
          </div>

          <!-- Availability Filter -->
          <div>
            <label class="block text-slate-400 font-semibold mb-1">Availability</label>
            <select id="guide-filter-avail" onchange="renderGuides()" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500">
              <option value="all">All Statuses</option>
              <option value="today">Available Today</option>
              <option value="this-week">Available This Week</option>
            </select>
          </div>

        </div>

        <div class="pt-3 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="relative w-full sm:w-96">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-2.5"></i>
            <input type="text" id="guide-search" oninput="renderGuides()" placeholder="Search guide by name, city, or specialty (e.g., Amer Fort, spices)..." class="w-full pl-9 pr-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white focus:outline-none focus:border-gold-500" />
          </div>
          <button onclick="clearGuideFilters()" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white font-semibold text-xs transition-colors shrink-0">
            Reset Filters
          </button>
        </div>
      </div>

      <!-- Guides Grid Container -->
      <div id="guides-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"></div>

    </div>
  </section>

