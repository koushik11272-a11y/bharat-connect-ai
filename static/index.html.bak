      <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-navy-900/90 border border-gold-500/30 text-xs font-semibold text-gold-300 shadow-xl backdrop-blur-md mb-6 animate-float">
