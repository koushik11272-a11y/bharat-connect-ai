          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 text-navy-950 text-[10px] font-extrabold uppercase tracking-widest shadow-lg">
