<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BharatConnect AI — Plan with AI. Navigate with locals. Experience India.</title>
  <meta name="description" content="A trusted AI-powered tourism and global collaboration platform connecting international travelers, verified local guides, authentic experiences, and cross-border partnerships." />

  <!-- Tailwind CSS CDN with custom config -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            navy: {
              950: '#071326',
              900: '#0B1F3A',
              800: '#132D54',
              700: '#1E3E6D',
              600: '#2A528F',
            },
            gold: {
              300: '#F3E5AB',
              400: '#E6CA65',
              500: '#D4AF37',
              600: '#B8952B',
              700: '#91721C',
            },
            charcoal: '#111827',
            softgray: '#F5F7FA'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
            serif: ['Playfair Display', 'Georgia', 'serif'],
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Three.js WebGL 3D Engine -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/static/css/styles.css" />
</head>
<body class="bg-navy-950 text-slate-100 antialiased selection:bg-gold-500 selection:text-navy-950">

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-20 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- ================================================== -->
  <!-- 0. AUTHENTICATION LANDING GATE SCREEN -->
  <!-- ================================================== -->
  <div id="auth-landing-screen" class="min-h-screen w-full flex flex-col justify-between bg-navy-950 bg-mandala relative overflow-x-hidden z-40" style="display: flex;">
    <!-- Ambient Cinematic Glows -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[450px] bg-gold-500/10 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-navy-700/20 rounded-full blur-[120px] pointer-events-none"></div>

    <!-- Landing Top Bar -->
    <header class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-24 flex items-center justify-between relative z-10">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-gold-300 via-gold-500 to-gold-700 flex items-center justify-center shadow-xl shadow-gold-500/20">
          <i data-lucide="compass" class="w-6 h-6 text-navy-950"></i>
        </div>
        <div>
          <span class="text-2xl font-black tracking-tight text-white flex items-center gap-1.5">
            BharatConnect <span class="text-gold-gradient font-black text-sm px-2 py-0.5 rounded-md bg-gold-500/15 border border-gold-500/40">AI</span>
          </span>
          <span class="block text-[10px] text-gold-400/90 tracking-widest uppercase font-bold">Plan with AI • Navigate with Locals • Experience India</span>
        </div>
      </div>
      <div class="hidden sm:flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/80 border border-gold-500/30 text-xs text-gold-300 backdrop-blur-md shadow-lg">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-semibold">Official Tourism & Trade Gateway</span>
      </div>
    </header>

    <!-- Center Hero Gate -->
    <main class="w-full max-w-4xl mx-auto px-4 py-8 sm:py-12 flex flex-col items-center text-center relative z-10 my-auto">
      <!-- Trust Chip -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-navy-900/90 border border-gold-500/30 text-xs font-semibold text-gold-300 shadow-xl backdrop-blur-md mb-6">
        <i data-lucide="shield-check" class="w-4 h-4 text-gold-400"></i>
        <span>Members-Only Access • Verified Travelers & Enterprise Partners</span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-serif-luxury text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-[1.15] mb-5">
        Welcome to <br class="hidden sm:inline" />
        <span class="text-gold-gradient">BharatConnect AI</span>
      </h1>

      <!-- Short Description -->
      <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed max-w-2xl mb-8">
        Create your account or sign in to unlock your personalized India travel experience.
      </p>

      <!-- Two Main Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full max-w-md mb-12">
        <button type="button" id="landing-signin-btn" onclick="openModal('signin-modal')" class="w-full sm:w-1/2 py-3.5 px-6 rounded-2xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-600 hover:brightness-110 text-navy-950 font-bold text-sm shadow-xl shadow-gold-500/25 hover:scale-[1.03] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2.5">
          <i data-lucide="log-in" class="w-4 h-4 text-navy-950"></i>
          <span>Sign In</span>
        </button>
        <button type="button" id="landing-register-btn" onclick="openModal('signup-modal')" class="w-full sm:w-1/2 py-3.5 px-6 rounded-2xl bg-navy-900/90 border border-gold-500/40 hover:border-gold-400 text-gold-300 hover:text-white font-bold text-sm hover:bg-gold-500/10 hover:scale-[1.03] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2.5 shadow-lg">
          <i data-lucide="user-plus" class="w-4 h-4 text-gold-400"></i>
          <span>Register</span>
        </button>
      </div>

      <!-- Experience Flight Journey Quick Access -->
      <div class="w-full max-w-md -mt-8 mb-10">
        <button type="button" id="landing-journey-btn" onclick="startFlightJourney(null, null, true)" class="w-full py-2.5 px-4 rounded-xl bg-navy-900/80 hover:bg-navy-800 border border-gold-500/30 hover:border-gold-400 text-xs text-gold-300 font-semibold transition-all duration-200 flex items-center justify-center gap-2 shadow-md hover:scale-[1.02] active:scale-[0.98]">
          <i data-lucide="plane" class="w-3.5 h-3.5 text-gold-400 animate-pulse"></i>
          <span>Experience Flight Journey to India &rarr;</span>
        </button>
      </div>

      <!-- 3 Preview Highlights -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 w-full text-left">
        <div class="glass-card rounded-2xl p-5 border border-slate-800 hover:border-gold-500/40 transition-all">
          <div class="w-9 h-9 rounded-xl bg-gold-500/15 text-gold-400 flex items-center justify-center mb-3">
            <i data-lucide="sparkles" class="w-5 h-5"></i>
          </div>
          <h3 class="font-bold text-white text-sm">AI Itinerary Planner</h3>
          <p class="text-xs text-slate-400 mt-1 leading-relaxed">Dynamic, custom itineraries tailored to your budget, style, and culinary interests.</p>
        </div>
        <div class="glass-card rounded-2xl p-5 border border-slate-800 hover:border-gold-500/40 transition-all">
          <div class="w-9 h-9 rounded-xl bg-gold-500/15 text-gold-400 flex items-center justify-center mb-3">
            <i data-lucide="compass" class="w-5 h-5"></i>
          </div>
          <h3 class="font-bold text-white text-sm">Verified Local Guides</h3>
          <p class="text-xs text-slate-400 mt-1 leading-relaxed">Direct connection with certified, vetted multilingual guides in Jaipur, Delhi & beyond.</p>
        </div>
        <div class="glass-card rounded-2xl p-5 border border-slate-800 hover:border-gold-500/40 transition-all">
          <div class="w-9 h-9 rounded-xl bg-gold-500/15 text-gold-400 flex items-center justify-center mb-3">
            <i data-lucide="briefcase" class="w-5 h-5"></i>
          </div>
          <h3 class="font-bold text-white text-sm">Global Trade Alliance</h3>
          <p class="text-xs text-slate-400 mt-1 leading-relaxed">Verified cross-border sourcing lounge for textiles, spices, and heritage crafts.</p>
        </div>
      </div>
    </main>

    <!-- Landing Footer -->
    <footer class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 text-center text-xs text-slate-500 relative z-10 border-t border-slate-800/60">
      <p>© 2026 BharatConnect AI • Ministry of Tourism & Enterprise Alliance Integrated • 256-Bit Encrypted</p>
    </footer>
  </div>

  <!-- ================================================== -->
  <!-- 0.5 CINEMATIC FLIGHT JOURNEY TO INDIA SCREEN -->
  <!-- ================================================== -->
  <div id="flight-journey-screen" class="hidden" style="display: none !important;">
    <!-- Scrollable virtual track that drives the flight -->
    <div id="journey-scroll-track" class="journey-scroll-track">
      <div class="journey-scroll-spacer"></div>
    </div>

    <!-- Fixed Stage for Map, Flight, HUD, and Arrival -->
    <div id="flight-stage-container" class="journey-stage flex flex-col justify-between p-4 sm:p-8 pointer-events-none">
      
      <!-- Top HUD Telemetry Bar -->
      <header class="w-full max-w-7xl mx-auto flex items-center justify-between pointer-events-auto z-40 bg-navy-950/75 border border-gold-500/20 rounded-2xl px-5 py-3.5 backdrop-blur-xl shadow-2xl">
        <!-- Flight Info Left -->
        <div class="flex items-center gap-3 sm:gap-4">
          <div class="w-10 h-10 rounded-xl bg-gold-500/15 border border-gold-500/30 flex items-center justify-center text-gold-400">
            <i data-lucide="plane" class="w-5 h-5 animate-pulse"></i>
          </div>
          <div>
            <div class="flex items-center gap-2 text-xs font-bold text-white tracking-wide">
              <span>GLOBAL GATEWAY</span>
              <span class="text-gold-400">✈</span>
              <span class="text-amber-400">INDIA ARRIVAL</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 ml-2 hidden md:inline">LIVE ROUTE</span>
            </div>
            <div class="flex items-center gap-3 text-[11px] text-slate-400 mt-0.5">
              <span id="flight-phase-label"><span id="telemetry-stage">Climb & Cruise</span> • Altitude: <span id="telemetry-altitude">38,000 ft</span></span>
              <span class="hidden sm:inline">•</span>
              <span id="flight-distance-label" class="hidden sm:inline"><span id="telemetry-distance">7,240 km</span> remaining</span>
            </div>
          </div>
        </div>

        <!-- Center Flight Progress Bar -->
        <div class="hidden md:flex flex-col items-center gap-1.5 w-64 lg:w-80">
          <div class="flex items-center justify-between w-full text-[10px] font-bold text-slate-400 uppercase tracking-wider">
            <span>Flight Progress</span>
            <span id="flight-progress-pct" class="text-gold-400 font-mono"><span id="telemetry-percent">0%</span></span>
          </div>
          <div class="w-full h-2 rounded-full bg-navy-900 border border-slate-700/80 overflow-hidden relative">
            <div id="flight-progress-bar" class="h-full bg-gradient-to-r from-gold-400 via-amber-500 to-emerald-400 rounded-full transition-all duration-75" style="width: 0%;"></div>
            <div id="journey-progress-bar" class="h-full bg-gradient-to-r from-gold-400 via-amber-500 to-emerald-400 rounded-full transition-all duration-75 absolute inset-0 opacity-0" style="width: 0%;"></div>
          </div>
        </div>

        <!-- Right: Skip Journey Button -->
        <div class="flex items-center gap-3">
          <button type="button" id="skip-journey-btn" onclick="skipFlightJourney()" class="group relative px-5 py-2.5 rounded-xl bg-gradient-to-r from-slate-900/90 to-navy-900/90 hover:from-gold-500 hover:to-gold-600 border border-gold-500/40 hover:border-gold-400 text-gold-300 hover:text-navy-950 text-xs font-bold transition-all duration-200 shadow-xl hover:shadow-gold-500/25 hover:scale-[1.03] active:scale-[0.97] flex items-center gap-2 cursor-pointer pointer-events-auto">
            <span>Skip Journey</span>
            <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </button>
        </div>
      </header>

      <!-- Interactive 3D WebGL Globe Canvas Container (Real Three.js 3D World Journey) -->
      <div id="globe-3d-canvas-container" class="absolute inset-0 w-full h-full overflow-hidden pointer-events-auto z-10"></div>

      <!-- Narrative Story Subtitle Bar -->
      <div id="journey-story-container" class="w-full flex justify-center pointer-events-none z-30 my-1">
        <div id="journey-story-subtitle" class="text-xs sm:text-sm font-semibold text-sky-200 tracking-wide bg-navy-950/75 px-5 py-2 rounded-full border border-sky-400/30 backdrop-blur-md shadow-xl inline-flex items-center gap-2">
          <span class="text-gold-400 font-serif-luxury font-bold">Your journey across the world</span>
          <span class="text-slate-500 text-xs">•</span>
          <span id="journey-story-route" class="text-slate-300 text-xs font-medium">From Japan to India</span>
        </div>
      </div>

      <!-- 3D Pinned Screen Badges (Projected from 3D Globe Coordinates) -->
      <div id="marker-origin-badge" class="globe-marker-badge hidden absolute pointer-events-none z-30 transition-transform duration-75">
        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-navy-950/90 border border-cyan-400/60 text-cyan-300 text-[11px] font-bold shadow-lg shadow-cyan-500/25 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span id="origin-badge-country">Japan</span>
          <span>📍</span>
        </div>
        <div class="text-[9px] text-cyan-300/80 text-center mt-0.5 tracking-wider uppercase font-semibold drop-shadow">Your starting point</div>
      </div>

      <div id="marker-destination-badge" class="globe-marker-badge hidden absolute pointer-events-none z-30 transition-transform duration-75">
        <div class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-navy-950/90 border border-gold-400/70 text-gold-300 text-xs font-bold shadow-xl shadow-gold-500/30 backdrop-blur-md">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span>India</span>
          <span>🇮🇳</span>
        </div>
        <div class="text-[9px] text-gold-300/80 text-center mt-0.5 tracking-wider uppercase font-semibold drop-shadow">Your destination</div>
      </div>

      <!-- Center Interactive Flight Map Stage -->
      <div class="relative w-full max-w-6xl mx-auto h-[65vh] flex items-center justify-center my-auto pointer-events-none z-20">
        
        <!-- Ambient Atmospheric Starfield Points -->
        <div id="journey-starfield" class="absolute inset-0 pointer-events-none">
          <div class="star-particle" style="top: 15%; left: 20%; width: 2px; height: 2px;"></div>
          <div class="star-particle" style="top: 25%; left: 75%; width: 3px; height: 3px; animation-delay: 1s;"></div>
          <div class="star-particle" style="top: 65%; left: 30%; width: 2px; height: 2px; animation-delay: 1.5s;"></div>
          <div class="star-particle" style="top: 80%; left: 85%; width: 2px; height: 2px; animation-delay: 0.5s;"></div>
          <div class="star-particle" style="top: 40%; left: 50%; width: 3px; height: 3px; animation-delay: 2s;"></div>
        </div>

        <!-- SVG Map & Flight Canvas (Maintained for Graceful Fallback & DOM Compatibility) -->
        <svg id="journey-map-svg" viewBox="0 0 1200 700" class="w-full h-full overflow-visible filter drop-shadow-2xl opacity-0 pointer-events-none absolute inset-0 -z-20">
          <defs>
            <linearGradient id="flightTrailGradient" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#D4AF37" stop-opacity="0.3" />
              <stop offset="60%" stop-color="#F59E0B" stop-opacity="0.8" />
              <stop offset="100%" stop-color="#10B981" stop-opacity="1" />
            </linearGradient>

            <filter id="indiaAuraGlow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="15" result="blur1" />
              <feGaussianBlur stdDeviation="30" result="blur2" />
              <feMerge>
                <feMergeNode in="blur2" />
                <feMergeNode in="blur1" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <!-- Stylized World Map Continents Outline (Europe, Middle East, Asia, India) -->
          <g id="world-map-continents" opacity="0.45" stroke="#1E3E6D" stroke-width="1.5" fill="#0E2547">
            <path d="M 80 180 Q 140 140 220 160 Q 280 190 320 220 Q 280 260 200 240 Q 130 250 80 180 Z" />
            <path d="M 230 270 Q 320 260 410 290 Q 480 340 460 440 Q 380 500 320 460 Q 240 380 230 270 Z" />
            <path d="M 440 160 Q 600 130 760 170 Q 820 240 760 300 Q 640 280 520 250 Z" />
            <path d="M 840 190 Q 980 170 1080 240 Q 1120 360 1020 440 Q 940 380 880 320 Z" />
          </g>

          <!-- Background dashed flight corridor guide -->
          <path id="flight-guide-line" d="M 160 360 C 360 120, 680 130, 920 380" fill="none" stroke="rgba(212, 175, 55, 0.25)" stroke-width="2.5" stroke-dasharray="8 8" />

          <!-- Illuminated active flight trail -->
          <path id="flight-trajectory-path" d="M 160 360 C 360 120, 680 130, 920 380" fill="none" stroke="url(#flightTrailGradient)" stroke-width="4.5" stroke-linecap="round" />

          <!-- Origin Departure Node -->
          <g id="origin-node" transform="translate(160, 360)">
            <circle r="16" fill="rgba(14, 165, 233, 0.2)" stroke="#38BDF8" stroke-width="1.5" />
            <circle r="6" fill="#38BDF8" />
            <text x="-10" y="32" fill="#94A3B8" font-size="12" font-family="'Plus Jakarta Sans', sans-serif" font-weight="700">DEPARTURE</text>
          </g>

          <!-- INDIA SUB-CONTINENT SILHOUETTE (Distinct Triangular Peninsula + Himalayas) -->
          <g id="india-destination-group" transform="translate(740, 240)">
            <path id="india-map-highlight" d="
              M 120 50 
              Q 170 40 210 60 
              Q 260 90 280 140 
              Q 260 190 240 230 
              Q 210 290 180 340 
              Q 175 350 170 340 
              Q 140 280 120 220 
              Q 90 160 100 110 
              Z" 
              fill="#0F2B48" 
              stroke="#D4AF37" 
              stroke-width="2" 
              class="transition-all duration-700" 
            />

            <!-- India Beacon Touchdown Point -->
            <g id="india-beacon-ripples" transform="translate(175, 200)" opacity="0" class="transition-opacity duration-500">
              <circle class="beacon-ring" r="30" fill="rgba(245, 158, 11, 0.25)" />
              <circle class="beacon-ring beacon-ring-2" r="50" fill="rgba(16, 185, 129, 0.2)" />
              <circle class="beacon-ring beacon-ring-3" r="70" fill="rgba(56, 189, 248, 0.15)" />
              <circle r="9" fill="#F59E0B" filter="drop-shadow(0 0 10px #F59E0B)" />
              <circle r="4" fill="#FFFFFF" />
            </g>

            <!-- India Label -->
            <text x="175" y="160" text-anchor="middle" fill="#F3E5AB" font-size="18" font-family="'Playfair Display', serif" font-weight="bold" letter-spacing="2" filter="drop-shadow(0 2px 8px rgba(0,0,0,0.8))">
              INDIA 🇮🇳
            </text>
          </g>
        </svg>

        <!-- Dynamic Animated Airplane Element -->
        <div id="journey-airplane-wrapper" style="left: 0px; top: 0px; transform: translate(-50%, -50%) rotate(0deg);">
          <div class="relative flex items-center justify-center">
            <div id="airplane-contrail" class="absolute right-7 w-12 h-3 bg-gradient-to-l from-amber-400 via-sky-400 to-transparent rounded-full blur-[2px] opacity-70 engine-active pointer-events-none -z-10"></div>
            <svg id="journey-airplane" class="w-12 h-12 text-white filter drop-shadow-[0_2px_10px_rgba(212,175,55,0.7)]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
            </svg>
          </div>
        </div>

        <!-- Arrival Welcome Card (Revealed at 100% arrival) -->
        <div id="journey-arrival-card" class="hidden glass-card max-w-lg w-full mx-4 p-8 sm:p-10 rounded-3xl text-center border-2 border-gold-500/50 bg-navy-950/90 backdrop-blur-2xl">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-400/20 via-gold-500/20 to-emerald-500/20 border border-gold-500/50 text-4xl mb-4 shadow-xl shadow-gold-500/20 animate-bounce">
            🇮🇳
          </div>
          <h2 class="font-serif-luxury text-3xl sm:text-4xl font-bold text-white mb-2.5 tracking-tight">
            Welcome to India 🇮🇳
          </h2>
          <p class="text-gold-300 font-medium text-base sm:text-lg mb-6 leading-relaxed">
            Your BharatConnect journey begins here.
          </p>
          <div class="flex items-center justify-center gap-2 text-xs font-semibold text-emerald-400 mb-4">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span>Touchdown Complete • Transitioning to Main Platform...</span>
          </div>
          <!-- 1.6s Hold indicator shimmer bar -->
          <div class="w-56 h-1.5 bg-navy-900 rounded-full mx-auto overflow-hidden border border-gold-500/30">
            <div id="arrival-hold-progress" class="arrival-hold-bar h-full bg-gradient-to-r from-gold-400 via-amber-500 to-emerald-400 rounded-full hold-progress-fill" style="width: 0%;"></div>
          </div>
        </div>

      </div>

      <!-- Bottom Telemetry & Scroll Prompt -->
      <footer class="w-full max-w-7xl mx-auto flex items-center justify-between text-xs text-slate-400 z-30 pb-2">
        <div class="hidden sm:flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse"></span>
          <span class="text-slate-300 font-medium">Scroll-Guided Aerial Navigation Active</span>
        </div>
        <div id="journey-scroll-prompt" class="flex items-center gap-2 mx-auto sm:mx-0 px-4 py-2 rounded-full bg-navy-900/80 border border-gold-500/30 text-gold-300 backdrop-blur-md shadow-lg animate-bounce">
          <i data-lucide="chevrons-down" class="w-4 h-4 text-gold-400"></i>
          <span class="font-bold tracking-wide">Scroll down to fly to India</span>
        </div>
        <div class="hidden sm:block text-right text-slate-500 font-mono text-[11px]">
          SYS-NAV • BHARATCONNECT AIRWAYS
        </div>
      </footer>

    </div>
  </div>

  <!-- ================================================== -->
  <!-- MAIN APPLICATION CONTENT (PROTECTED BY AUTH GATE) -->
  <!-- ================================================== -->
  <div id="main-app-content" class="hidden" style="display: none !important;">

  <!-- Global Navigation Bar -->
  <header class="fixed top-0 left-0 right-0 z-40 glass-nav transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-gold-300 via-gold-500 to-gold-700 flex items-center justify-center shadow-lg shadow-gold-500/20 group-hover:scale-105 transition-transform duration-300">
          <i data-lucide="compass" class="w-6 h-6 text-navy-950"></i>
        </div>
        <div>
