              <input type="text" id="collab-track-input" placeholder="Enter Tracking ID (e.g. BC-9041)..." class="w-full pl-9 pr-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-xs text-white focus:outline-none focus:border-gold-500" />
