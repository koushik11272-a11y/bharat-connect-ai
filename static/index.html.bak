  <!-- 17. TRUST AND SAFETY -->
  <!-- ================================================== -->
  <section class="py-24 bg-navy-950 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block mb-2">Peace of Mind</span>
        <h2 class="font-serif-luxury text-3xl sm:text-4xl font-bold text-white leading-tight">
          Trust, Safety & Security Protocol
        </h2>
        <p class="mt-3 text-sm text-slate-300 leading-relaxed">
          Designed to support informed and confident travel decisions.
        </p>
      </div>

      <!-- 9 Trust & Safety Pillars Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Pillar 1: Guide Verification -->
        <div class="glass-card rounded-2xl p-6 hover:border-gold-500/40 transition-all">
          <div class="w-10 h-10 rounded-xl bg-gold-500/20 text-gold-400 flex items-center justify-center mb-3">
            <i data-lucide="badge-check" class="w-5 h-5"></i>
          </div>
          <h4 class="font-bold text-white text-base mb-1.5">1. Guide Verification</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            All guides must hold valid Ministry of Tourism accreditation, undergo government biometric identity verification (Aadhaar KYC), police background clearance, and pass conversational English fluency interviews.
          </p>
        </div>

        <!-- Pillar 2: Business Profile Verification -->
        <div class="glass-card rounded-2xl p-6 hover:border-gold-500/40 transition-all">
          <div class="w-10 h-10 rounded-xl bg-gold-500/20 text-gold-400 flex items-center justify-center mb-3">
            <i data-lucide="building" class="w-5 h-5"></i>
          </div>
          <h4 class="font-bold text-white text-base mb-1.5">2. Business Profile Verification</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            Enterprise partners in the Global Collaboration Lounge undergo business registration vetting, official board certification audits (Spices Board, Fair Trade, NASSCOM, Heritage Hotels), and on-site provenance checks.
          </p>
        </div>

        <!-- Pillar 3: User Ratings and Reviews -->
        <div class="glass-card rounded-2xl p-6 hover:border-gold-500/40 transition-all">
          <div class="w-10 h-10 rounded-xl bg-gold-500/20 text-gold-400 flex items-center justify-center mb-3">
            <i data-lucide="star" class="w-5 h-5"></i>
          </div>
          <h4 class="font-bold text-white text-base mb-1.5">3. User Ratings & Reviews</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            Unfiltered, verified traveler feedback. Only travelers who have booked and completed journeys through BharatConnect AI can publish ratings, preventing fake reviews or sponsored manipulation.
          </p>
        </div>

        <!-- Pillar 4: Secure Communication -->
        <div class="glass-card rounded-2xl p-6 hover:border-gold-500/40 transition-all">
          <div class="w-10 h-10 rounded-xl bg-gold-500/20 text-gold-400 flex items-center justify-center mb-3">
            <i data-lucide="lock" class="w-5 h-5"></i>
          </div>
          <h4 class="font-bold text-white text-base mb-1.5">4. Secure Communication</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            End-to-end encrypted messaging channels protect traveler privacy. Personal mobile numbers and home addresses remain shielded until both traveler and guide mutually approve direct contact.
          </p>
        </div>

        <!-- Pillar 5: Privacy-Focused Design -->
        <div class="glass-card rounded-2xl p-6 hover:border-gold-500/40 transition-all">
          <div class="w-10 h-10 rounded-xl bg-gold-500/20 text-gold-400 flex items-center justify-center mb-3">
            <i data-lucide="shield-alert" class="w-5 h-5"></i>
          </div>
          <h4 class="font-bold text-white text-base mb-1.5">5. Privacy-Focused Design</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            Built strictly in accordance with GDPR, California CCPA, and India's Digital Personal Data Protection (DPDP) Act. Travelers maintain complete control to export or permanently delete their travel history.
          </p>
        </div>

        <!-- Pillar 6: Clear Terms and Conditions -->
        <div class="glass-card rounded-2xl p-6 hover:border-gold-500/40 transition-all">
          <div class="w-10 h-10 rounded-xl bg-gold-500/20 text-gold-400 flex items-center justify-center mb-3">
            <i data-lucide="file-text" class="w-5 h-5"></i>
          </div>
          <h4 class="font-bold text-white text-base mb-1.5">6. Clear Terms & Conditions</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            Written in plain, accessible language with zero predatory fine print. Clear cancellation windows, standardized refund policies, and transparent boundaries regarding guide duties and commercial relationships.
          </p>
        </div>

        <!-- Pillar 7: Transparent Pricing -->
        <div class="glass-card rounded-2xl p-6 hover:border-gold-500/40 transition-all">
          <div class="w-10 h-10 rounded-xl bg-gold-500/20 text-gold-400 flex items-center justify-center mb-3">
            <i data-lucide="credit-card" class="w-5 h-5"></i>
          </div>
          <h4 class="font-bold text-white text-base mb-1.5">7. Transparent Pricing</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            All prices displayed simultaneously in US Dollars ($) and Indian Rupees (₹). Total costs itemize guide honorarium, private transit fuel, and entrance tickets upfront so you never face awkward surprise charges.
          </p>
        </div>

        <!-- Pillar 8: Report and Support Features -->
        <div class="glass-card rounded-2xl p-6 hover:border-gold-500/40 transition-all border-gold-500/30">
          <div class="w-10 h-10 rounded-xl bg-gold-500/20 text-gold-400 flex items-center justify-center mb-3">
            <i data-lucide="alert-octagon" class="w-5 h-5"></i>
          </div>
          <h4 class="font-bold text-white text-base mb-1.5">8. Report & Support Features</h4>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Instant 24/7 in-app incident reporting with guaranteed 2-hour response dispatch by our dedicated bilingual travel safety ombudsman.
          </p>
          <button onclick="openModal('report-modal')" class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-gold-400 font-bold text-xs transition-colors flex items-center gap-1.5">
            <i data-lucide="flag" class="w-3.5 h-3.5"></i> Submit Report / Inquiry
          </button>
        </div>

        <!-- Pillar 9: Emergency Information Resources -->
        <div class="glass-card rounded-2xl p-6 hover:border-gold-500/40 transition-all border-red-500/30">
          <div class="w-10 h-10 rounded-xl bg-red-500/20 text-red-400 flex items-center justify-center mb-3">
            <i data-lucide="phone-call" class="w-5 h-5"></i>
          </div>
          <h4 class="font-bold text-white text-base mb-1.5">9. Emergency Information</h4>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            One-touch direct linkage to the US Embassy in New Delhi, regional US consulates (Mumbai, Chennai, Kolkata, Hyderabad), Tourist Police Helpline (1363), and 112 National Dispatch.
          </p>
          <button onclick="toggleEmergencyDrawer()" class="px-3.5 py-1.5 rounded-xl bg-red-500/20 hover:bg-red-500/30 text-red-300 font-bold text-xs transition-colors flex items-center gap-1.5">
            <i data-lucide="shield-alert" class="w-3.5 h-3.5"></i> Open Emergency SOS Hub
          </button>
        </div>

      </div>

      <!-- Responsible Safety Statement Notice -->
      <div class="mt-12 p-5 rounded-2xl bg-navy-900/80 border border-slate-800 text-center max-w-3xl mx-auto">
        <p class="text-xs text-slate-300 leading-relaxed">
          <strong class="text-gold-400">Responsible Safety Disclosure:</strong> We do not make claims of guaranteed absolute safety, as travel everywhere involves human environments and personal discretion. BharatConnect AI is <span class="text-white font-semibold underline decoration-gold-400">designed to support informed and confident travel decisions</span> through verified accountability, prompt human assistance, and transparent resources.
        </p>
      </div>

    </div>
  </section>

