# BharatConnect AI - Admin Gmail SMTP Configuration
# Use a 16-character Google App Password generated from:
# https://myaccount.google.com/apppasswords
#
# IMPORTANT SECURITY:
# Never commit your actual .env file or real passwords to source control.
# Copy this file to .env and fill in your details.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ADMIN_EMAIL=
